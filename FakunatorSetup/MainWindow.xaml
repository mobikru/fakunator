<Window x:Class="FakunatorSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Факунатора" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <!-- Кнопки -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366f1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5457e5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#cbd5e1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource AccentBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f1f5f9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Оболочка с тенью и скругленными углами -->
    <Border Background="White" CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.18" ShadowDepth="0" BlurRadius="28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>   <!-- banner: фикс -->
                <RowDefinition Height="Auto"/>  <!-- body: по контенту -->
                <RowDefinition Height="66"/>    <!-- footer: фикс -->
            </Grid.RowDefinitions>

            <!-- ── АНИМИРОВАННЫЙ БАННЕР ───────────────────────── -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" ClipToBounds="True" Background="#1e1b4b">
                <Grid>
                    <!-- Слой 1: плавающие цветные орбы (aurora effect) -->
                    <Canvas>
                        <!-- Ellipse 1 — фиолетовый, ходит по диагонали -->
                        <Ellipse Width="260" Height="260" Fill="#8b5cf6" Opacity="0.75">
                            <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Tr1" X="-60" Y="-20"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Tr1" Storyboard.TargetProperty="X"
                                                             From="-60" To="180" Duration="0:0:9"/>
                                            <DoubleAnimation Storyboard.TargetName="Tr1" Storyboard.TargetProperty="Y"
                                                             From="-20" To="-80" Duration="0:0:7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <!-- Ellipse 2 — розовый, ходит справа налево -->
                        <Ellipse Width="240" Height="240" Fill="#ec4899" Opacity="0.7" Canvas.Left="330" Canvas.Top="-40">
                            <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Tr2" X="0" Y="0"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Tr2" Storyboard.TargetProperty="X"
                                                             From="0" To="-180" Duration="0:0:11"/>
                                            <DoubleAnimation Storyboard.TargetName="Tr2" Storyboard.TargetProperty="Y"
                                                             From="0" To="70" Duration="0:0:8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <!-- Ellipse 3 — голубой, снизу -->
                        <Ellipse Width="220" Height="220" Fill="#06b6d4" Opacity="0.55" Canvas.Left="140" Canvas.Top="80">
                            <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Tr3" X="0" Y="0"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Tr3" Storyboard.TargetProperty="X"
                                                             From="0" To="140" Duration="0:0:13"/>
                                            <DoubleAnimation Storyboard.TargetName="Tr3" Storyboard.TargetProperty="Y"
                                                             From="0" To="-40" Duration="0:0:10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <!-- Ellipse 4 — малиновый акцент справа снизу -->
                        <Ellipse Width="180" Height="180" Fill="#f43f5e" Opacity="0.55" Canvas.Left="420" Canvas.Top="60">
                            <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Tr4" X="0" Y="0"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Tr4" Storyboard.TargetProperty="X"
                                                             From="0" To="-100" Duration="0:0:6"/>
                                            <DoubleAnimation Storyboard.TargetName="Tr4" Storyboard.TargetProperty="Y"
                                                             From="0" To="-30" Duration="0:0:5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Canvas>

                    <!-- Слой 2: тонкая тёмная маска для читаемости текста -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0"   Color="#00000000"/>
                                <GradientStop Offset="0.6" Color="#20000000"/>
                                <GradientStop Offset="1"   Color="#40000000"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Drag-зона (кроме крестика) — идёт РАНЬШЕ кнопки, чтобы Z-order не съедал клик -->
                    <Border Background="Transparent" MouseLeftButtonDown="OnDragTop"/>

                    <!-- Кнопка закрыть (drawn on top after drag layer) -->
                    <Button x:Name="BtnClose" Content="✕" Click="OnCloseClick"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="36" Height="30" Margin="0,6,10,0"
                            Background="#22000000" Foreground="White" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#55ff5555"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Логотип с пульсацией -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="StackPanel.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="1.04" Duration="0:0:2.5"/>
                                        <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="1.04" Duration="0:0:2.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <TextBlock Text="🛰" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="White" Opacity="0.95">
                            <TextBlock.Effect><DropShadowEffect Color="Black" Opacity="0.35" ShadowDepth="0" BlurRadius="10"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="ФАКУНАТОР" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" Typography.Capitals="AllSmallCaps">
                            <TextBlock.Effect><DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="0" BlurRadius="12"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtSubtitle" Text="Мастер установки"
                                   FontSize="11.5" Foreground="White" Opacity="0.9"
                                   HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock.Effect><DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="0" BlurRadius="6"/></TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── ТЕЛО ───────────────────────────────────────── -->
            <!-- Симметричные отступы (18/18), MinHeight фиксирует общую высоту чтобы
                 разные экраны (Ready / Installing / Done / Error) не заставляли окно прыгать -->
            <Grid Grid.Row="1" Margin="30,18,30,18" MinHeight="180">
                <!-- Экран Ready -->
                <StackPanel x:Name="PanelReady" VerticalAlignment="Top">
                    <!-- Компактный чип с версией -->
                    <Border HorizontalAlignment="Center" Background="#eef2ff" CornerRadius="20"
                            Padding="14,6" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#22c55e" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtVersionLine" Text="Проверка обновлений…" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="#4338ca" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Настройки установки — тёмный чёткий бордер -->
                    <Border BorderBrush="#cbd5e1" BorderThickness="1.5" CornerRadius="10" Padding="16,14"
                            Background="#f8fafc">
                        <StackPanel>
                            <TextBlock Text="ПАПКА УСТАНОВКИ" FontSize="9.5" FontWeight="SemiBold"
                                       Opacity="0.7" Foreground="#64748b" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Обзор" Style="{StaticResource GhostBtn}"
                                        Padding="12,4" FontSize="11" Margin="6,0,0,0"
                                        Click="OnBrowseClick"/>
                                <TextBox x:Name="TxtInstallPath" FontSize="12" Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="#94a3b8" Background="White" Foreground="#0f172a"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox x:Name="ChkDesktop"   Content="Ярлык на рабочем столе" IsChecked="True"
                                          FontSize="11.5" Foreground="#334155" Margin="0,0,20,0"/>
                                <CheckBox x:Name="ChkStartMenu" Content="В меню Пуск" IsChecked="True"
                                          FontSize="11.5" Foreground="#334155"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Экран Installing -->
                <StackPanel x:Name="PanelInstalling" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" Text="Скачивание…" FontSize="14" FontWeight="SemiBold"
                               Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Value="0"
                                 Background="#e2e8f0" Foreground="#6366f1" BorderThickness="0"/>
                    <TextBlock x:Name="TxtProgressPct" Text="0 %" FontSize="11" HorizontalAlignment="Right"
                               Foreground="#64748b" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtBytes" Text="" FontSize="11" HorizontalAlignment="Center"
                               Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Экран Done -->
                <StackPanel x:Name="PanelDone" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="✓" FontSize="60" Foreground="#22c55e"
                               HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtDoneTitle" Text="Установлено!" FontSize="18" FontWeight="SemiBold"
                               Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                    <TextBlock x:Name="TxtDoneSub" Text="Факунатор готов к запуску." FontSize="12"
                               Foreground="#64748b" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Экран Error -->
                <StackPanel x:Name="PanelError" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="⚠" FontSize="52" Foreground="#ef4444"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Что-то пошло не так" FontSize="16" FontWeight="SemiBold"
                               Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,10,0,6"/>
                    <TextBlock x:Name="TxtError" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="440" FontSize="11.5" Foreground="#ef4444"/>
                </StackPanel>
            </Grid>

            <!-- ── FOOTER (кнопки) ────────────────────────────── -->
            <Border Grid.Row="2" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Background="#f8fafc">
                <DockPanel Margin="20,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtFooter" Text="v1.0" FontSize="10"
                               Foreground="#94a3b8" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnPrimary" Content="Установить"
                            Style="{StaticResource AccentBtn}" Click="OnPrimaryClick"
                            VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnCancel" Content="Отмена"
                            Style="{StaticResource GhostBtn}" Margin="0,0,8,0"
                            VerticalAlignment="Center" Click="OnCloseClick"/>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
