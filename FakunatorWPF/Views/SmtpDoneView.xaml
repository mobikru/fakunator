<UserControl x:Class="Fakunator.Views.SmtpDoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Fakunator.Core">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" x:Name="RootPanel">

            <!-- ── Hero card ──────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <!-- Green left accent stripe -->
                    <Border Width="4" HorizontalAlignment="Left"
                            Background="#22c55e"
                            CornerRadius="12,0,0,12"/>

                    <DockPanel Margin="20,16">
                        <!-- Green checkmark circle -->
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24"
                                Background="#22c55e"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="&#x2713;" Foreground="White"
                                       FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Right-side stat boxes -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <!-- ВРЕМЯ -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{core:Tr smtp.done.time}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroElapsed" Text="00:00" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- СКОРОСТЬ -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{core:Tr smtp.done.speed}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroSpeed" Text="0/с" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ВСЕГО -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{core:Tr smtp.done.total}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroTotal" Text="0" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Title & subtitle -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{core:Tr smtp.done.title}" FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock x:Name="TxtSubtitle" FontSize="13"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       Margin="0,4,0,0"
                                       Text="Из 0 адресов: 0 валидных (0%)"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ── 5 verdict cards ────────────────────────────────── -->
            <UniformGrid Rows="1" Columns="5" Margin="0,0,0,16">
                <!-- Populated from code-behind -->
            </UniformGrid>
            <WrapPanel x:Name="VerdictPanel" Orientation="Horizontal" Margin="0,0,0,16"/>

            <!-- ── Bottom actions ──────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{core:Tr smtp.done.btnOpenFolder}" Style="{StaticResource GhostBtn}"
                        Padding="20,8" Margin="0,0,8,0"
                        Click="OnOpenFolderClick"/>
                <Button Content="{core:Tr smtp.done.btnNewRun}" Style="{StaticResource GhostBtn}"
                        Padding="20,8" Margin="0,0,8,0"
                        Click="OnNewRunClick"/>
                <Button x:Name="BtnErrors" Content="{core:Tr smtp.done.btnErrors}"
                        Style="{StaticResource DangerBtn}"
                        Padding="20,8" Visibility="Collapsed"
                        Click="OnShowErrorsClick"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
