<Window x:Class="Fakunator.Views.MessagePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Превью письма · Gmail" Width="1080" Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg1Brush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!-- Сегментированный переключатель: pill-стиль, hover/checked состояния -->
            <Style x:Key="SegBtn" TargetType="RadioButton">
                <Setter Property="Padding" Value="16,7"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource Bg3Brush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- Toolbar сверху: переключатели вида + инфо -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" x:Name="TxtInfo" FontSize="11"
                       Foreground="{DynamicResource Fg4Brush}" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Right"
                    Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                    CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbGmail" Content="📧 Gmail" IsChecked="True"
                                 GroupName="PreviewMode" Style="{StaticResource SegBtn}"
                                 Checked="OnModeChanged"/>
                    <RadioButton x:Name="RbRaw" Content="🌐 Как есть"
                                 GroupName="PreviewMode" Style="{StaticResource SegBtn}"
                                 Checked="OnModeChanged"/>
                    <RadioButton x:Name="RbMobile" Content="📱 Мобильный"
                                 GroupName="PreviewMode" Style="{StaticResource SegBtn}"
                                 Checked="OnModeChanged"/>
                    <RadioButton x:Name="RbCode" Content="&lt;/&gt; Код"
                                 GroupName="PreviewMode" Style="{StaticResource SegBtn}"
                                 Checked="OnModeChanged"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Body: WebView2 + fallback -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                CornerRadius="8" Background="#f6f8fc" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="Web"/>
                <TextBox x:Name="TxtFallback" Visibility="Collapsed"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Padding="16"
                         Background="White" Foreground="#202124" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" x:Name="BtnCopy" Content="⧉ Скопировать HTML"
                    Padding="14,7" Cursor="Hand"
                    Style="{DynamicResource GhostBtn}"
                    Click="OnCopyHtml"/>
            <Button DockPanel.Dock="Right" Content="Закрыть"
                    Padding="18,7" Cursor="Hand"
                    Style="{DynamicResource AccentBtn}"
                    Click="OnClose"/>
        </DockPanel>
    </Grid>
</Window>
