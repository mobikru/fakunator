<UserControl x:Class="Fakunator.Views.SidebarDomainsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Fakunator.Core">

    <DockPanel Margin="16,16,16,20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">

            <!-- Header -->
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                    Padding="14,12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="🌍" FontSize="20"
                               Foreground="{DynamicResource Accent2Brush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{core:Tr domains.sidebar.title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <TextBlock Text="{core:Tr domains.sidebar.subtitle}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{core:Tr domains.sidebar.accountsHeader}"
                       FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg3Brush}"
                       Margin="2,0,0,10"/>

            <Button Content="{core:Tr domains.sidebar.btnAddAccount}"
                    Command="{Binding AddAccountCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    HorizontalAlignment="Stretch"
                    Padding="0,10" Margin="0,0,0,10"/>

            <!-- Status text -->
            <Border Background="{DynamicResource Bg2Brush}" CornerRadius="8"
                    Padding="10,8" Margin="0,0,0,14">
                <TextBlock Text="{Binding Status}"
                           FontSize="10.5"
                           Foreground="{DynamicResource Fg3Brush}"
                           TextWrapping="Wrap"
                           MinHeight="14"/>
            </Border>

            <!-- ── Mail.ru Postmaster (ниже ISP-аккаунтов) ─────────── -->
            <TextBlock Text="{core:Tr domains.sidebar.postmasterHeader}"
                       FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg3Brush}"
                       Margin="2,4,0,8"/>

            <Button Content="{core:Tr domains.sidebar.btnConnectMailRu}"
                    Command="{Binding ConnectMailRuCommand}"
                    Style="{StaticResource GhostBtn}"
                    HorizontalAlignment="Stretch"
                    Padding="0,8" Margin="0,0,0,4"/>

            <Button Content="{core:Tr domains.sidebar.btnOpenPostmaster}"
                    Command="{Binding OpenPostmasterCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    HorizontalAlignment="Stretch"
                    Padding="0,8" Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding PostmasterAccounts}" Margin="0,0,0,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="8"
                                Padding="10,7" Margin="0,2,0,2">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="×"
                                        Command="{Binding DataContext.RemoveMailRuCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource Fg4Brush}"
                                        FontSize="16" Padding="4,0"
                                        Cursor="Hand" ToolTip="{core:Tr domains.sidebar.tooltipDisconnectMailRu}"/>
                                <TextBlock Text="{Binding Username}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Fg1Brush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Список аккаунтов, скроллится внутри. Выбранный = ActiveAccount -->
        <ListBox ItemsSource="{Binding Accounts}"
                 SelectedItem="{Binding ActiveAccount, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 Margin="0,0,10,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="brd" CornerRadius="8" Padding="10,8"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="brd" Property="Background"
                                                Value="{DynamicResource AccentSoftBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="brd" Property="Background"
                                                Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter TargetName="brd" Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="×"
                                Command="{Binding DataContext.RemoveAccountCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource Fg4Brush}"
                                FontSize="16" Padding="6,0"
                                Cursor="Hand" ToolTip="{core:Tr domains.sidebar.tooltipRemoveAccount}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="10.5"
                                       Foreground="{DynamicResource Fg4Brush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                <Run Text=" @ "/>
                                <Run Text="{Binding Host, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
