<UserControl x:Class="Fakunator.Views.AnalyzeDoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Fakunator.Core">

    <Grid Margin="20,14" x:Name="RootPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Hero -->
            <RowDefinition Height="Auto"/>  <!-- KPI -->
            <RowDefinition Height="Auto"/>  <!-- Top countries -->
            <RowDefinition Height="*"/>     <!-- Results grid fills remaining -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

            <!-- Hero summary card -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <!-- Purple left accent stripe -->
                    <Border Width="4" HorizontalAlignment="Left"
                            Background="#818cf8"
                            CornerRadius="12,0,0,12"/>

                    <DockPanel Margin="20,16">
                        <!-- Check circle -->
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5e6ad2" Offset="0"/>
                                    <GradientStop Color="#818cf8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x2713;" Foreground="White"
                                       FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Right stat boxes -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <!-- СТОИМОСТЬ AI -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{core:Tr analyze.done.costLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroCost" Text="$ 0.00" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="#eab308"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ТОКЕНОВ -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{core:Tr analyze.done.tokensLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroTokens" Text="0" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ВРЕМЯ -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{core:Tr analyze.done.timeLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroElapsed" Text="00:00" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Title -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeroTitle"
                                       Text="Анализ завершён" FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock x:Name="TxtSubtitle" FontSize="13"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       Margin="0,4,0,0"
                                       Text="Из 0 адресов: 0 через БД, 0 через AI"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 5 KPI cards -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,0,0,14">
                <!-- ОБРАБОТАНО -->
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{core:Tr analyze.done.kpiProcessed}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="KpiProcessed" Text="0" FontSize="18"
                                   FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Fg1Brush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ЧЕРЕЗ БД -->
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{core:Tr analyze.done.kpiDb}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="KpiDb" Text="0" FontSize="18"
                                   FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                   Foreground="#22c55e"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ЧЕРЕЗ AI -->
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{core:Tr analyze.done.kpiAi}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="KpiAi" Text="0" FontSize="18"
                                   FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                   Foreground="#a78bfa"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- НЕ ОПРЕД. -->
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{core:Tr analyze.done.kpiUnknown}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="KpiUnknown" Text="0" FontSize="18"
                                   FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                   Foreground="#71717a"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- СКОРОСТЬ -->
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{core:Tr analyze.done.kpiSpeed}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="KpiSpeed" Text="0/с" FontSize="18"
                                   FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Fg1Brush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Country bar chart -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14" x:Name="CountryCard"
                    Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{core:Tr analyze.done.topCountries}" FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               Margin="0,0,0,10"/>
                    <StackPanel x:Name="CountryBarsPanel"/>
                </DockPanel>
            </Border>

            <!-- Results DataGrid (fills remaining space) -->
            <Border Grid.Row="3" Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource Border1Brush}"
                    BorderThickness="1" CornerRadius="12"
                    ClipToBounds="True" Padding="0"
                    Margin="0,0,0,14">
                <DataGrid x:Name="ResultsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource Bg3Brush}"
                          Foreground="{DynamicResource Fg1Brush}"
                          FontSize="11.5"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{core:Tr analyze.done.colEmail}" Binding="{Binding Email}" Width="*" MinWidth="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{core:Tr analyze.done.colName}" Binding="{Binding NameToken}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{core:Tr analyze.done.colGender}" Binding="{Binding GenderDisplay}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{core:Tr analyze.done.colCountry}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <Image Source="{Binding Iso, Converter={StaticResource IsoToFlagImage}}"
                                               Width="20" Height="14" Stretch="Uniform"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Iso}" FontFamily="{StaticResource MonoFont}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{core:Tr analyze.done.colSource}" Binding="{Binding SourceDisplay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{core:Tr analyze.done.colSignals}" Binding="{Binding Signals}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bottom actions -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{core:Tr analyze.done.btnCsv}" Style="{StaticResource GhostBtn}"
                        Padding="16,8" Margin="0,0,8,0"
                        Click="OnExportCsvClick"/>
                <Button Content="{core:Tr analyze.done.btnJson}" Style="{StaticResource GhostBtn}"
                        Padding="16,8" Margin="0,0,8,0"
                        Click="OnExportJsonClick"/>
                <Button Content="{core:Tr analyze.done.btnNewFile}" Style="{StaticResource GhostBtn}"
                        Padding="16,8" Margin="0,0,8,0"
                        Click="OnNewFileClick"/>
                <Button Content="{core:Tr analyze.done.btnOpenFolder}" Style="{StaticResource GhostBtn}"
                        Padding="16,8"
                        Click="OnOpenFolderClick"/>
            </StackPanel>

    </Grid>
</UserControl>
