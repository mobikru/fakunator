<Window x:Class="Fakunator.Views.PmtaCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление PMTA" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg1Brush}">
    <StackPanel Margin="24">
        <TextBlock Text="Выбери команды для применения" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtPanel" FontSize="11"
                   Foreground="{DynamicResource Fg4Brush}" Margin="0,0,0,18"/>

        <!-- Стек чекбоксов команд -->
        <Border Background="{DynamicResource Bg2Brush}"
                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                CornerRadius="8" Padding="14">
            <StackPanel>
                <CheckBox x:Name="CbPause" Content="⏸  Пауза" FontSize="13"
                          Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,10"
                          ToolTip="pause queue *"/>
                <CheckBox x:Name="CbResume" Content="▶  Убрать паузу" FontSize="13"
                          Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,10"
                          ToolTip="resume queue *"/>
                <CheckBox x:Name="CbNormal" Content="⚡  Режим нормал (все очереди)" FontSize="13"
                          Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,10"
                          ToolTip="set queue --mode=normal *"/>
                <CheckBox x:Name="CbResetCounters" Content="🔢  Сброс счётчиков" FontSize="13"
                          Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,10"
                          ToolTip="reset counters"/>
                <CheckBox x:Name="CbReload" Content="🔄  Перезагрузить конфиг" FontSize="13"
                          Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,10"
                          ToolTip="reload"/>
                <Separator Margin="0,4,0,10"/>
                <CheckBox x:Name="CbClearQueues" Content="🗑  Очистить все очереди (необратимо!)"
                          FontSize="13" Foreground="#ef4444" FontWeight="SemiBold"
                          ToolTip="delete --older-than=0s"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Команды выполнятся последовательно на выбранной панели. Результат каждой покажется в общем отчёте."
                   FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                   Foreground="{DynamicResource Fg4Brush}"/>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="▶ Применить выбранное"
                    Padding="18,8" MinWidth="200" Cursor="Hand"
                    Style="{DynamicResource AccentBtn}" Click="OnApply"/>
            <Button DockPanel.Dock="Right" Content="Отмена"
                    Padding="14,8" MinWidth="90" Margin="0,0,8,0" Cursor="Hand"
                    Style="{DynamicResource GhostBtn}" Click="OnCancel"/>
        </DockPanel>
    </StackPanel>
</Window>
