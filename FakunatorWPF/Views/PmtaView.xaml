<UserControl x:Class="Fakunator.Views.PmtaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource Bg1Brush}">

    <UserControl.Resources>
        <Style x:Key="TileCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="PanelListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,16,32,16">
        <!-- Убрал внешний header — заголовок «📡 PMTA» и всё управление съехало
             прямо в шапку Overview, чтобы не было пустой строки сверху. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: кнопка обзора + список панелей + общий график -->
            <Border Grid.Column="0" Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                    CornerRadius="12" Padding="12">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="📊  Общий обзор"
                            Command="{Binding ShowOverviewCommand}"
                            Padding="12,10" Margin="0,0,0,10"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            FontSize="12" Cursor="Hand"
                            Style="{DynamicResource GhostBtn}"/>
                    <TextBlock DockPanel.Dock="Top" Text="ВАШИ ПАНЕЛИ"
                               FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                               Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,8"/>

                    <!-- Общий график снизу -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg3Brush}"
                            CornerRadius="8" Padding="8" Margin="0,10,0,0" Height="120">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ОБЩИЙ TRAFFIC · rcp/мин"
                                       FontSize="9.5" Opacity="0.7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg3Brush}"/>
                            <lvc:CartesianChart Series="{Binding AggregateSeries}"
                                                XAxes="{Binding AggregateXAxes}"
                                                YAxes="{Binding AggregateYAxes}"
                                                TooltipPosition="Hidden"
                                                LegendPosition="Hidden"/>
                        </DockPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Panels}"
                             SelectedItem="{Binding SelectedPanel, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PanelListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding StatusColor}"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg1Brush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource Fg4Brush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding OutRcpLastMin, Mode=OneWay}"/>
                                            <Run Text=" rcp/мин · очередь "/>
                                            <Run Text="{Binding QueueRcp, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: обзор ИЛИ детали выбранной панели -->
            <Grid Grid.Column="2">
                <!-- ═══ OVERVIEW: сводка + таблица + большие графики ═══ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0"
                              Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Одна линия: заголовок раздела + тайлы + кнопка добавить -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Общий обзор PMTA-панелей" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg1Brush}"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource Fg4Brush}" Margin="0,4,0,0">
                                    <Run Text="{Binding OnlinePanels}"/><Run Text=" из "/>
                                    <Run Text="{Binding TotalPanels}"/><Run Text=" панелей онлайн · обновление каждые 7 сек"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource TileCard}" MinWidth="120" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalOutRcpLastMin, StringFormat={}{0:N0}}"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="#22c55e"/>
                                        <TextBlock Text="ОТПРАВЛЕНО / МИН" FontSize="9" Opacity="0.7"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileCard}" MinWidth="120" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalQueueRcp, StringFormat={}{0:N0}}"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="#f59e0b"/>
                                        <TextBlock Text="В ОЧЕРЕДИ" FontSize="9" Opacity="0.7"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileCard}" MinWidth="120">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalSmtpOutCur, StringFormat={}{0:N0}}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg1Brush}"/>
                                        <TextBlock Text="СОЕДИНЕНИЙ" FontSize="9" Opacity="0.7"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="14,0,0,0">
                                <Button Content="+ Добавить панель"
                                        Command="{Binding AddPanelCommand}"
                                        Padding="14,8" FontSize="12" FontWeight="SemiBold"
                                        Style="{DynamicResource AccentBtn}" Cursor="Hand"/>
                                <Button Content="↻ Обновить"
                                        Command="{Binding RefreshCommand}"
                                        Padding="14,8" FontSize="12" FontWeight="SemiBold"
                                        Style="{DynamicResource GhostBtn}" Cursor="Hand"
                                        Margin="8,0,0,0"
                                        ToolTip="Форсированный опрос всех панелей сейчас"/>
                            </StackPanel>
                        </Grid>

                        <!-- Два компактных графика в одну строку -->
                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,16">
                            <Border Style="{StaticResource TileCard}" Padding="12" Margin="0,0,6,0" Height="160">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ОБЩАЯ РАССЫЛКА · RCP/МИН"
                                               FontSize="10" FontWeight="SemiBold" Opacity="0.7"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                    <lvc:CartesianChart Series="{Binding AggregateSeries}"
                                                        XAxes="{Binding AggregateXAxes}"
                                                        YAxes="{Binding AggregateYAxes}"
                                                        TooltipPosition="Hidden"
                                                        LegendPosition="Hidden"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource TileCard}" Padding="12" Margin="6,0,0,0" Height="160">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ОБЩАЯ ЗАГРУЗКА ОЧЕРЕДЕЙ · RCP"
                                               FontSize="10" FontWeight="SemiBold" Opacity="0.7"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                    <lvc:CartesianChart Series="{Binding AggregateQueueSeries}"
                                                        XAxes="{Binding AggregateXAxes}"
                                                        YAxes="{Binding AggregateYAxes}"
                                                        TooltipPosition="Hidden"
                                                        LegendPosition="Hidden"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Таблица со всех панелей -->
                        <TextBlock Text="ПАНЕЛИ" FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                                   Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding Panels}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent"
                                  CanUserAddRows="False"
                                  SelectedItem="{Binding SelectedPanel, Mode=TwoWay}">
                            <!-- ElementStyle для DataGridTextColumn — implicit-стиль
                                 WPF-квирк, для генерируемых DataGridTextColumn TextBlock'ов
                                 не работает, поэтому регистрируем явным ключом. -->
                            <DataGrid.Resources>
                                <Style x:Key="CellText" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                </Style>
                            </DataGrid.Resources>
                            <!-- Подсветка строки по ActivityBackground. -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="{Binding ActivityBackground}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="40"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding StatusColor}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="НАЗВАНИЕ" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" Margin="10,0">
                                                <Hyperlink Foreground="{DynamicResource Accent2Brush}"
                                                           TextDecorations="{x:Null}"
                                                           Command="{Binding DataContext.OpenPanelDetailCommand,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}">
                                                    <Hyperlink.Style>
                                                        <Style TargetType="Hyperlink">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Hyperlink.Style>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ПОЛУЧЕНО" Binding="{Binding InRcpTotal, StringFormat={}{0:N0}}" Width="120"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ОТПРАВЛЕНО" Binding="{Binding OutRcpTotal, StringFormat={}{0:N0}}" Width="140"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ЗА ЧАС" Binding="{Binding OutRcpLastHr, StringFormat={}{0:N0}}" Width="120"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="RCP/МИН" Binding="{Binding OutRcpLastMin, StringFormat={}{0:N0}}" Width="100"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ОЧЕРЕДЬ" Binding="{Binding QueueRcp, StringFormat={}{0:N0}}" Width="100"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Placeholder если нет ни одной панели -->
                <Border Visibility="{Binding NoPanels, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Bg2Brush}"
                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📡" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="Добавьте PMTA-панель"
                                   Foreground="{DynamicResource Fg3Brush}" FontSize="14"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Кнопка «+ Добавить панель» сверху справа"
                                   Foreground="{DynamicResource Fg4Brush}" FontSize="11"
                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Detail view. DataContext вешаем на внутренний StackPanel, а не
                     на ScrollViewer — иначе Visibility="{Binding IsDetail}" ищется на
                     SelectedPanel и молча падает, оставляя Visible. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0"
                              Visibility="{Binding IsDetail, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding SelectedPanel}">
                        <!-- Header выбранной -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{Binding StatusColor}" Margin="0,0,10,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg1Brush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="✎ Редактировать"
                                        Command="{Binding DataContext.EditPanelCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="12,7" FontSize="11.5"
                                        Style="{DynamicResource GhostBtn}" Cursor="Hand"/>
                                <Button Content="🗑 Удалить"
                                        Command="{Binding DataContext.RemovePanelCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="12,7" FontSize="11.5" Margin="6,0,0,0"
                                        Style="{DynamicResource DangerBtn}" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Fg4Brush}" Margin="0,0,0,14">
                            <Run Text="{Binding EndpointText, Mode=OneWay}"/>
                            <Run Text="   ·   PMTA "/>
                            <Run Text="{Binding Version, Mode=OneWay}"/>
                            <Run Text="   ·   "/>
                            <Run Text="{Binding HostName, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- Управление PMTA — одна кнопка → диалог с чекбоксами команд -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="⚙  Управление PMTA"
                                    Command="{Binding DataContext.OpenCommandsCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Padding="16,9" FontSize="12" FontWeight="SemiBold"
                                    Style="{DynamicResource AccentBtn}" Cursor="Hand"/>
                            <TextBlock Text="выбери набор команд (пауза / резюм / нормал / сброс / очистка)"
                                       FontSize="10.5" Foreground="{DynamicResource Fg4Brush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- Тайлы -->
                        <UniformGrid Rows="1" Margin="0,0,0,14">
                            <Border Style="{StaticResource TileCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding OutRcpLastMin, StringFormat={}{0:N0}}"
                                               FontSize="20" FontWeight="SemiBold" Foreground="#22c55e"/>
                                    <TextBlock Text="RCP / МИН" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileCard}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding OutRcpLastHr, StringFormat={}{0:N0}}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="RCP / ЧАС" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileCard}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding OutRcpTotal, StringFormat={}{0:N0}}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="ВСЕГО" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileCard}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold"
                                               Foreground="#f59e0b">
                                        <Run Text="{Binding QueueRcp, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    </TextBlock>
                                    <TextBlock Text="В ОЧЕРЕДИ" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}">
                                        <Run Text="{Binding SmtpOutCur, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding SmtpOutMax, Mode=OneWay}" FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock Text="SMTP OUT" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Графики -->
                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,14">
                            <Border Style="{StaticResource TileCard}" Margin="0,0,6,0" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ОТПРАВКА · RCP / МИН"
                                               FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                    <lvc:CartesianChart Series="{Binding SendSeries}"
                                                        XAxes="{Binding EmptyXAxes}"
                                                        YAxes="{Binding YAxes}"
                                                        TooltipPosition="Hidden"
                                                        LegendPosition="Hidden"
                                                        Height="200"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource TileCard}" Margin="6,0,0,0" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ОЧЕРЕДЬ"
                                               FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                    <lvc:CartesianChart Series="{Binding QueueSeriesChart}"
                                                        XAxes="{Binding EmptyXAxes}"
                                                        YAxes="{Binding YAxes}"
                                                        TooltipPosition="Hidden"
                                                        LegendPosition="Hidden"
                                                        Height="200"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Сводка ошибок — сразу видно почему панель тормозит -->
                        <TextBlock Text="СВОДКА ОШИБОК" FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                                   Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ErrorSummary}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Bg2Brush}"
                                            BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Category}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Fg1Brush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LatestExample}"
                                                       FontSize="10.5" Foreground="{DynamicResource Fg4Brush}"
                                                       Margin="14,0,10,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding LatestExample}"/>
                                            <Border Grid.Column="2" Background="#ef4444"
                                                    CornerRadius="10" Padding="10,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}"
                                                           Foreground="White" FontWeight="SemiBold"
                                                           FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Табличка Очередей -->
                        <TextBlock Text="ТОП ОЧЕРЕДЕЙ" FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                                   Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Queues}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource Bg2Brush}"
                                  AlternationCount="2" CanUserAddRows="False"
                                  MaxHeight="240" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ОЧЕРЕДЬ" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="RCP" Binding="{Binding Rcp, StringFormat={}{0:N0}}" Width="90"/>
                                <DataGridTextColumn Header="KB" Binding="{Binding Kb, StringFormat={}{0:N1}}" Width="90"/>
                                <DataGridTextColumn Header="CONN" Binding="{Binding Conn}" Width="60"/>
                                <DataGridTemplateColumn Header="ОШИБОК" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" Margin="8,0" FontSize="11">
                                                <Run Text="{Binding Errors.Count, Mode=OneWay}"
                                                     Foreground="#ef4444" FontWeight="SemiBold"/>
                                                <Run Text=" · ⓘ" Foreground="{DynamicResource Fg4Brush}"/>
                                                <TextBlock.ToolTip>
                                                    <ToolTip MaxWidth="600">
                                                        <ItemsControl ItemsSource="{Binding Errors}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                                                        <Run Text="{Binding Time, Mode=OneWay}"
                                                                             Foreground="Gray" FontSize="10"/>
                                                                        <LineBreak/>
                                                                        <Run Text="{Binding Text, Mode=OneWay}"
                                                                             FontSize="11"/>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- VMTAs -->
                        <TextBlock Text="VIRTUAL MTA" FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                                   Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Vmtas}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource Bg2Brush}"
                                  AlternationCount="2" CanUserAddRows="False"
                                  MaxHeight="200" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VMTA" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="RCP" Binding="{Binding Rcp, StringFormat={}{0:N0}}" Width="90"/>
                                <DataGridTextColumn Header="%" Binding="{Binding PctOfTotal}" Width="60"/>
                                <DataGridTextColumn Header="CONN" Binding="{Binding Conn}" Width="60"/>
                                <DataGridTextColumn Header="DOM" Binding="{Binding Dom}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Errors -->
                        <TextBlock Text="ПОСЛЕДНИЕ ОШИБКИ" FontSize="10.5" FontWeight="SemiBold" Opacity="0.7"
                                   Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding RecentErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Bg2Brush}" CornerRadius="6"
                                            Padding="10,6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Time}" FontSize="10"
                                                       Foreground="{DynamicResource Fg4Brush}"/>
                                            <TextBlock Text="{Binding Text}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Fg2Brush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
