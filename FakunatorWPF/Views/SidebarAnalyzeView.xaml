<UserControl x:Class="Fakunator.Views.SidebarAnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Fakunator.Core">

    <UserControl.Resources>
        <!-- Compact numeric input style -->
        <Style x:Key="CompactBox" TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Border3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,16">

            <!-- ── Header card ─────────────────────────────────── -->
            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#245e6ad2" Offset="0"/>
                        <GradientStop Color="#15818cf8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="🔬" FontSize="20"
                               Foreground="{DynamicResource Accent2Brush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{core:Tr analyze.sidebar.headerTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <TextBlock Text="{core:Tr analyze.sidebar.headerSubtitle}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Section: Режимы работы ──────────────────────── -->
            <TextBlock Text="{core:Tr analyze.sidebar.modesSection}" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg3Brush}"
                       Margin="2,0,0,8"/>

            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="ChkUseAi"
                              Foreground="{DynamicResource Fg1Brush}" FontSize="12.5"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged">
                        <TextBlock Text="{core:Tr analyze.sidebar.useAiTitle}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Text="{core:Tr analyze.sidebar.useAiDesc}"
                               FontSize="10" Foreground="{DynamicResource Fg4Brush}"
                               TextWrapping="Wrap" Margin="22,2,0,10"/>

                    <CheckBox x:Name="ChkTwoPass"
                              Foreground="{DynamicResource Fg1Brush}" FontSize="12.5"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged">
                        <TextBlock Text="{core:Tr analyze.sidebar.twoPassTitle}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Text="{core:Tr analyze.sidebar.twoPassDesc}"
                               FontSize="10" Foreground="{DynamicResource Fg4Brush}"
                               TextWrapping="Wrap" Margin="22,2,0,10"/>

                    <CheckBox x:Name="ChkSkipJunk"
                              Foreground="{DynamicResource Fg1Brush}" FontSize="12.5"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged">
                        <TextBlock Text="{core:Tr analyze.sidebar.skipJunkTitle}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Text="{core:Tr analyze.sidebar.skipJunkDesc}"
                               FontSize="10" Foreground="{DynamicResource Fg4Brush}"
                               TextWrapping="Wrap" Margin="22,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── Section: AI-модель ──────────────────────────── -->
            <TextBlock Text="{core:Tr analyze.sidebar.modelSection}" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg3Brush}"
                       Margin="2,0,0,8"/>

            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Provider -->
                    <DockPanel Margin="0,0,0,10">
                        <ComboBox x:Name="CmbProvider" DockPanel.Dock="Right"
                                  Style="{StaticResource CompactCombo}"
                                  SelectedIndex="0" SelectionChanged="OnProviderChanged">
                            <ComboBoxItem Content="openai"/>
                            <ComboBoxItem Content="anthropic"/>
                        </ComboBox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{core:Tr analyze.sidebar.providerTitle}" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock Text="{core:Tr analyze.sidebar.providerDesc}" FontSize="10"
                                       Foreground="{DynamicResource Fg4Brush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource Border1Brush}" Margin="0,0,0,10"/>

                    <!-- Model radio cards -->
                    <Border x:Name="CardMini" Margin="0,0,0,8" Padding="10,8"
                            CornerRadius="8" Cursor="Hand"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource AccentSoftBrush}"
                            MouseLeftButtonDown="OnModelMiniClick">
                        <DockPanel>
                            <RadioButton x:Name="RbMini" DockPanel.Dock="Left"
                                         GroupName="ModelSidebar" IsChecked="True"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Checked="OnModelChanged"/>
                            <Border x:Name="BadgeMini" DockPanel.Dock="Right" Background="#1622c55e"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="11"
                                           Foreground="#22c55e" FontWeight="Bold"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMiniName" Text="gpt-4o-mini"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg1Brush}"/>
                                <TextBlock x:Name="TxtMiniPrice" Text="$0.15 / $0.60 за M"
                                           FontSize="10"
                                           Foreground="{DynamicResource Fg3Brush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="CardFull" Padding="10,8"
                            CornerRadius="8" Cursor="Hand"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource Border1Brush}"
                            Background="Transparent"
                            MouseLeftButtonDown="OnModelFullClick">
                        <DockPanel>
                            <RadioButton x:Name="RbFull" DockPanel.Dock="Left"
                                         GroupName="ModelSidebar" IsChecked="False"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Checked="OnModelChanged"/>
                            <Border x:Name="BadgeFull" DockPanel.Dock="Right" Background="#1622c55e"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock Text="✓" FontSize="11"
                                           Foreground="#22c55e" FontWeight="Bold"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFullName" Text="gpt-4o"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg1Brush}"/>
                                <TextBlock x:Name="TxtFullPrice" Text="$2.50 / $10 за M"
                                           FontSize="10"
                                           Foreground="{DynamicResource Fg3Brush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Section: Лимиты ─────────────────────────────── -->
            <TextBlock Text="{core:Tr analyze.sidebar.limitsSection}" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg3Brush}"
                       Margin="2,0,0,8"/>

            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Spend cap -->
                    <DockPanel Margin="0,0,0,10">
                        <TextBox x:Name="TxtSpendCap" DockPanel.Dock="Right"
                                 Style="{StaticResource CompactBox}"
                                 Text="105.0" TextChanged="OnSpendCapChanged"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{core:Tr analyze.sidebar.spendCapTitle}" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock Text="{core:Tr analyze.sidebar.spendCapDesc}" FontSize="10"
                                       Foreground="{DynamicResource Fg4Brush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource Border1Brush}" Margin="0,0,0,10"/>

                    <!-- Batch size -->
                    <DockPanel Margin="0,0,0,10">
                        <ComboBox x:Name="CmbBatchSize" DockPanel.Dock="Right"
                                  Style="{StaticResource CompactCombo}"
                                  SelectedIndex="0" SelectionChanged="OnBatchSizeChanged">
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                            <ComboBoxItem Content="150"/>
                            <ComboBoxItem Content="200"/>
                        </ComboBox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{core:Tr analyze.sidebar.batchSizeTitle}" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock Text="{core:Tr analyze.sidebar.batchSizeDesc}" FontSize="10"
                                       Foreground="{DynamicResource Fg4Brush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource Border1Brush}" Margin="0,0,0,10"/>

                    <!-- Concurrent -->
                    <DockPanel>
                        <ComboBox x:Name="CmbConcurrent" DockPanel.Dock="Right"
                                  Style="{StaticResource CompactCombo}"
                                  SelectedIndex="4" SelectionChanged="OnConcurrentChanged">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{core:Tr analyze.sidebar.concurrentTitle}" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock Text="{core:Tr analyze.sidebar.concurrentDesc}" FontSize="10"
                                       Foreground="{DynamicResource Fg4Brush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ── Budget estimate (dashed border) ─────────────── -->
            <Border CornerRadius="10" Padding="14,12"
                    Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource AccentSoftBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="💵" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{core:Tr analyze.sidebar.budgetHeader}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtEstCost" FontSize="18"
                               FontFamily="{StaticResource MonoFont}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Fg1Brush}"
                               Text="~$ 0.00"/>
                    <TextBlock x:Name="TxtEstTokens" FontSize="10.5"
                               Foreground="{DynamicResource Fg4Brush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text=""/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
