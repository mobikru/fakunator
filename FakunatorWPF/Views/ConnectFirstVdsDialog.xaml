<Window x:Class="Fakunator.Views.ConnectFirstVdsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Подключение FirstVDS · авторизация в браузере"
        Width="1100" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg1Brush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource Bg2Brush}"
                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Ellipse Width="9" Height="9" DockPanel.Dock="Left" Margin="0,0,10,0"
                         VerticalAlignment="Center" Fill="{Binding StatusColor,
                             ElementName=Root, FallbackValue='#9ca3af'}"/>
                <Button x:Name="BtnContinue" DockPanel.Dock="Right" Content="→ Подключить"
                        Padding="14,6" Cursor="Hand"
                        Click="OnContinueClick"
                        Style="{StaticResource AccentBtn}"/>
                <TextBox x:Name="TxtServerId" DockPanel.Dock="Right"
                         Width="120" Height="30" Margin="8,0,10,0"
                         FontFamily="Consolas" FontSize="12"
                         VerticalContentAlignment="Center" Padding="8,0"
                         Background="{DynamicResource Bg2Brush}"
                         BorderBrush="{DynamicResource Border2Brush}"
                         Foreground="{DynamicResource Fg1Brush}"
                         ToolTip="ID сервера — видно в первой колонке таблицы «Виртуальные серверы»"/>
                <TextBlock DockPanel.Dock="Right" Text="ID сервера:" FontSize="11"
                           Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock x:Name="StatusLine" Text="Залогинься → введи ID сервера → жми «Подключить»"
                           FontSize="11"
                           Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                           ToolTipService.ShowDuration="30000">
                    <TextBlock.ToolTip>
                        <TextBlock Text="{Binding Text, ElementName=StatusLine}"
                                   FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="900"/>
                    </TextBlock.ToolTip>
                </TextBlock>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
