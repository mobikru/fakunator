<UserControl x:Class="Fakunator.Views.DomainScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Fakunator.Core">

    <UserControl.Resources>
        <!-- Общий стиль compact-input (для фильтров/поиска в браузере) -->
        <Style x:Key="FilterInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
            <Setter Property="Background" Value="{DynamicResource Bg1Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="brd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="brd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки-таблетки в шапке браузера ("Проверить заново" / "Экспорт") -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" CornerRadius="8"
                                Background="{DynamicResource Bg1Brush}"
                                BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{DynamicResource Fg1Brush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основная accent-кнопка (Применить) -->
        <Style x:Key="ApplyBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" CornerRadius="8"
                                Background="{DynamicResource AccentBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background"
                                        Value="{DynamicResource Accent2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost / secondary (Сбросить) -->
        <Style x:Key="ResetBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <!-- Read-only cell для строк браузера: TextBlock не выделяется мышью,
             поэтому используем flat TextBox — прозрачный, без рамки, ReadOnly. -->
        <Style x:Key="CellText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsUndoEnabled" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}"/>
            <!-- Убираем внутренние отступы шаблона TextBox -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Focusable="False"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox для фильтров ("Зона", "NS-провайдер") — flat + rounded -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
            <Setter Property="Background" Value="{DynamicResource Bg1Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="brd" CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="1" Text="⌄" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg3Brush}" IsHitTestVisible="False"/>
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  IsChecked="{Binding Path=IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="{DynamicResource Bg1Brush}"
                                        BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                                        CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260" Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="BorderBrush" Value="{DynamicResource Border3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="brd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="brd" CornerRadius="4"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="brd" Property="Background"
                                                    Value="{DynamicResource AccentSoftBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="brd" Property="Background"
                                                    Value="{DynamicResource AccentSoftBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Grid c 3 строками: KPI (Auto), Live-feed (Auto), Browser (*).
         Браузер забирает всё оставшееся пространство. Когда Live-feed свёрнут,
         его строка становится маленькой — браузер растягивается автоматически. -->
    <Grid Margin="20,14,20,20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <!-- ── 6 KPI cards ─────────────────────────────────────── -->
            <UniformGrid Grid.Row="0" Rows="1" Columns="6" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="KpiFetched" Text="0" FontSize="19" FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <TextBlock Text="{core:Tr domainscanner.kpi.fetched}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2.5,0,2.5,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="KpiProcessed" Text="0" FontSize="19" FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <TextBlock Text="{core:Tr domainscanner.kpi.checked}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2.5,0,2.5,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="KpiSaved" Text="0" FontSize="19" FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="#ef4444"/>
                        <TextBlock Text="{core:Tr domainscanner.kpi.abandoned}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2.5,0,2.5,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="KpiSpeed" Text="0" FontSize="19" FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <TextBlock Text="{core:Tr domainscanner.kpi.speed}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2.5,0,2.5,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="KpiErrors" Text="0" FontSize="19" FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="#f59e0b"/>
                        <TextBlock Text="{core:Tr domainscanner.kpi.errors}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="KpiTotal" Text="0" FontSize="19" FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <TextBlock Text="{core:Tr domainscanner.kpi.totalInDb}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Live feed (свёртываемый) ────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,10,10,14" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Заголовок = кнопка Toggle: клик → IsFeedExpanded flip -->
                    <Button x:Name="BtnFeedToggle" Click="OnFeedToggle"
                            Background="Transparent" BorderThickness="0" Padding="0,4"
                            Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <TextBlock x:Name="TxtFeedChevron" DockPanel.Dock="Left"
                                       Text="▼" FontSize="10"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#f59e0b"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{core:Tr domainscanner.liveFeed.title}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg2Brush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{core:Tr domainscanner.liveFeed.last60sec}" DockPanel.Dock="Right"
                                       FontSize="10.5"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </DockPanel>
                    </Button>

                    <!-- Контент feed'а: свёртывается по IsFeedExpanded -->
                    <StackPanel x:Name="FeedContent" Margin="0,6,0,0">

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{core:Tr domainscanner.colDomain}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{core:Tr domainscanner.colNsProvider}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{core:Tr domainscanner.liveFeed.colStatus}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border1Brush}" Margin="0,0,0,4"/>

                    <ItemsControl x:Name="FeedList" MinHeight="140" MaxHeight="160">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter Margin="0,0,10,0"/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="11.5"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" FontSize="11.5"
                                               Foreground="{DynamicResource Fg2Brush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ProviderOrDead}">
                                                <Binding Path="NsProvider"/>
                                                <Binding Path="[domainscanner.liveFeed.noResponse]" Source="{x:Static core:Loc.Instance}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" FontSize="11.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{Binding Status, Converter={StaticResource StatusColor}}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StatusRu}">
                                                <Binding Path="Status"/>
                                                <Binding Path="[domainscanner.liveFeed.colStatus]" Source="{x:Static core:Loc.Instance}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="TxtFeedPlaceholder"
                               Text="{core:Tr domainscanner.liveFeed.waiting}" FontSize="11.5"
                               Foreground="{DynamicResource Fg4Brush}"
                               HorizontalAlignment="Center" Margin="0,20,0,10"/>
                    </StackPanel>  <!-- FeedContent -->
                </StackPanel>
            </Border>

            <!-- ── Browser: занимает всё оставшееся пространство ───── -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14,10,14">
                <!-- DockPanel: топ-Auto (заголовок+фильтры+шапка), фут-Auto (пагинация),
                     центр — LastChildFill=True, туда ItemsControl растянется. -->
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{core:Tr domainscanner.browser.title}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg2Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBrowserCount" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="{core:Tr domainscanner.browser.btnReverify}" Style="{StaticResource ToolBtn}"
                                    Command="{Binding ReverifyCommand}"/>
                            <Button Content="{core:Tr domainscanner.browser.btnExport}" Style="{StaticResource ToolBtn}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ExportCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filters row -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="{core:Tr domainscanner.browser.btnReset}"
                                Style="{StaticResource ResetBtn}"
                                Margin="8,0,0,0"
                                Command="{Binding ResetFiltersCommand}"/>
                        <Button DockPanel.Dock="Right" Content="{core:Tr domainscanner.browser.btnApply}"
                                Style="{StaticResource ApplyBtn}"
                                Command="{Binding ApplyFiltersCommand}"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- Зона: ComboBox из БД -->
                            <ComboBox Width="130" Margin="0,0,8,0"
                                      Style="{StaticResource FilterCombo}"
                                      ItemsSource="{Binding AvailableZones}"
                                      SelectedItem="{Binding FilterZone, UpdateSourceTrigger=PropertyChanged, TargetNullValue=все, FallbackValue=все}"/>

                            <!-- NS-провайдер: ComboBox из БД -->
                            <ComboBox Width="200" Margin="0,0,8,0"
                                      Style="{StaticResource FilterCombo}"
                                      ItemsSource="{Binding AvailableProviders}"
                                      SelectedItem="{Binding FilterProvider, UpdateSourceTrigger=PropertyChanged, TargetNullValue=все, FallbackValue=все}"/>

                            <!-- NS-хост -->
                            <Grid Width="110" Margin="0,0,8,0">
                                <TextBox x:Name="FNs" Style="{StaticResource FilterInput}"
                                         Text="{Binding FilterNsHost, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock IsHitTestVisible="False"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           FontSize="11.5"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{core:Tr domainscanner.browser.nsHostPlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FNs}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Поиск по имени -->
                            <Grid Width="170">
                                <TextBox x:Name="FQuery" Style="{StaticResource FilterInput}"
                                         Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock IsHitTestVisible="False"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           FontSize="11.5"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{core:Tr domainscanner.browser.searchPlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </DockPanel>

                    <!-- Table header — тот же margin справа что и у ListBox items для align -->
                    <Grid DockPanel.Dock="Top" Margin="10,4,20,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{core:Tr domainscanner.colDomain}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{core:Tr domainscanner.browser.colZone}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{core:Tr domainscanner.colNsProvider}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="{core:Tr domainscanner.browser.colAge}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="{core:Tr domainscanner.browser.colDaysLeft}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="{core:Tr domainscanner.browser.colRbl}" FontSize="9.5"
                                   Foreground="{DynamicResource Fg4Brush}" FontWeight="SemiBold"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{DynamicResource Border1Brush}" Margin="0,0,0,4"/>

                    <!-- Pagination footer прикреплён к низу — ставим ПЕРЕД BrowserList -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" FontSize="10.5"
                                   Text="{core:Tr domainscanner.browser.footerNote}"
                                   Foreground="{DynamicResource Fg4Brush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{core:Tr domainscanner.browser.btnPrev}" Style="{StaticResource ToolBtn}"
                                    Command="{Binding PrevPageCommand}"/>
                            <TextBlock Margin="14,0,14,0" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource Fg2Brush}">
                                <Run Text="{core:Tr domainscanner.browser.pagePrefix}"/>
                                <Run Text="{Binding BrowserPage}"/>
                                <Run Text="{core:Tr domainscanner.browser.pageOf}"/>
                                <Run Text="{Binding BrowserTotalPages, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="{core:Tr domainscanner.browser.btnNext}" Style="{StaticResource ToolBtn}"
                                    Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="BrowserList" ItemsSource="{Binding BrowserRows}"
                             MinHeight="170"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch"
                             AlternationCount="2">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent"
                                                    Padding="10,4,10,4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter TargetName="bd" Property="Background"
                                                            Value="{DynamicResource Bg2Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background"
                                                            Value="{DynamicResource Bg5Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource CellText}"
                                             Text="{Binding Domain, Mode=OneWay}"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="11.5"
                                             Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource CellText}"
                                             Text="{Binding Zone, Mode=OneWay}"
                                             FontSize="11.5"
                                             Foreground="{DynamicResource Fg2Brush}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource CellText}"
                                             Text="{Binding NsProvider, Mode=OneWay}"
                                             FontSize="11.5"
                                             Foreground="{DynamicResource Fg2Brush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding AgeText}"
                                               Foreground="{Binding AgeColor}"
                                               FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DaysLeftText}"
                                               Foreground="{Binding DaysLeftColor}"
                                               FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding RblText}"
                                               Foreground="{Binding RblColor}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>
    </Grid>
</UserControl>
