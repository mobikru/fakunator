<UserControl x:Class="Fakunator.Views.DomainsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ── Header-icon (крупный градиентный квадрат для карточек) ─── -->
        <Style x:Key="HeaderIcon" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Chip кнопки-действия (мини, только иконка) ─────────────── -->
        <Style x:Key="ActionIconBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg4Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Account switcher pill (активный аккаунт большой, кликается для дропа) -->
        <Style x:Key="AccountPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Мини-кнопка "Добавить" (текст + значок) ───────────────── -->
        <Style x:Key="LinkAddBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Row icon-btn (в таблицах — карандаш, стрелка, треш) ────── -->
        <Style x:Key="RowIconBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg4Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ячейка "аватар" для аккаунта — буква в цветном круге ──── -->
        <Style x:Key="AvatarCircle" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ── Плоская ячейка-текст (как в DomainScanner): выделяется мышью, без рамки -->
        <Style x:Key="CellText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsUndoEnabled" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Focusable="False"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20,16,20,16" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════ TOP-LEFT: DNS-панель — компактный менеджер ══════════ -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}"
                    Padding="16,14,12,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть: иконка + название + статус -->
                    <Border Grid.Column="0" Style="{StaticResource HeaderIcon}" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#818cf8" Offset="0"/>
                                <GradientStop Color="#5e6ad2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⌬" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DNS-панель" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding IspConnectedDot}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding IspConnectionText}" FontSize="11"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Действия -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionIconBtn}" Content="↻"
                                ToolTip="Обновить домены"
                                Command="{Binding RefreshDomainsCommand}"/>
                        <Button Style="{StaticResource ActionIconBtn}" Content="+"
                                FontSize="18" FontWeight="Bold"
                                ToolTip="Добавить аккаунт панели"
                                Command="{Binding AddAccountCommand}"/>
                        <Button Style="{StaticResource ActionIconBtn}" Content="⏻"
                                ToolTip="Отключиться"
                                Command="{Binding LogoutIspCommand}"/>
                    </StackPanel>

                    <!-- Вторая строка: активный аккаунт + свитчер (dropdown) -->
                    <Grid Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="1"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Height="36"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding ActiveAccountChip, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="×"
                                                Width="22" Height="22"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource Fg4Brush}"
                                                FontSize="15" Cursor="Hand"
                                                ToolTip="Удалить аккаунт"
                                                Command="{Binding DataContext.RemoveAccountCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource AvatarCircle}"
                                                Background="{Binding AvatarBrush}">
                                            <TextBlock Text="{Binding AvatarLetter}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Fg1Brush}"/>
                                            <TextBlock FontSize="10.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource Fg3Brush}"
                                                       Margin="0,1,0,0">
                                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                                <Run Text=" · " Foreground="{DynamicResource Fg4Brush}"/>
                                                <Run Text="{Binding Host, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="1" Text="ISPmanager · Zone.DNS"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   FontSize="10" Foreground="{DynamicResource Fg4Brush}"/>
                    </Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                </Grid>
            </Border>

            <!-- ══════════ TOP-RIGHT: Постмастер Mail.ru ══════════ -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}"
                    Padding="16,14,12,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HeaderIcon}" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3b82f6" Offset="0"/>
                                <GradientStop Color="#1e40af" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="✉" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Постмастер Mail.ru" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg1Brush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding PostmasterConnectedDot}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PostmasterConnectionText}" FontSize="11"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionIconBtn}" Content="↻"
                                ToolTip="Обновить"
                                Command="{Binding RefreshPostmasterCommand}"/>
                        <Button Style="{StaticResource ActionIconBtn}" Content="+"
                                FontSize="18" FontWeight="Bold"
                                ToolTip="Подключить mail.ru"
                                Command="{Binding ConnectMailRuCommand}"/>
                        <Button Style="{StaticResource ActionIconBtn}" Content="⏻"
                                ToolTip="Отключиться"
                                Command="{Binding LogoutPostmasterCommand}"/>
                    </StackPanel>

                    <Grid Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="1"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Height="36"
                                  ItemsSource="{Binding PostmasterAccounts}"
                                  SelectedItem="{Binding ActivePostmasterAccountChip, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="×"
                                                Width="22" Height="22"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource Fg4Brush}"
                                                FontSize="15" Cursor="Hand"
                                                ToolTip="Удалить аккаунт"
                                                Command="{Binding DataContext.RemoveMailRuCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource AvatarCircle}"
                                                Background="{Binding AvatarBrush}">
                                            <TextBlock Text="{Binding AvatarLetter}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Username, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource Fg1Brush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="1" Text="Postmaster API v1"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   FontSize="10" Foreground="{DynamicResource Fg4Brush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════ BOTTOM-LEFT: Домены в DNS-панели ══════════ -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}"
                    Padding="0" Margin="0,14,0,0">
                <DockPanel LastChildFill="True">
                    <!-- Заголовок -->
                    <Grid DockPanel.Dock="Top" Margin="18,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Домены в DNS-панели"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="10" Padding="7,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Bg3Brush}">
                                <TextBlock FontSize="10.5"
                                           Foreground="{DynamicResource Fg2Brush}">
                                    <Run Text="{Binding DnsRows.Count, Mode=OneWay}"/>
                                    <Run Text=" зон"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="+ Добавить домен"
                                    Style="{StaticResource AccentBtn}"
                                    Padding="12,6" FontSize="12"
                                    Command="{Binding AddDomainCommand}"
                                    ToolTip="Создать новую зону в панели"/>
                            <Button Style="{StaticResource RowIconBtn}"
                                    Content="↻" ToolTip="Обновить"
                                    Margin="6,0,0,0"
                                    Command="{Binding RefreshDomainsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding DnsRows}"
                              Margin="10,4,10,10"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ClipboardCopyMode="ExcludeHeader"
                              AlternationCount="2"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource Bg2Brush}"
                              Foreground="{DynamicResource Fg1Brush}"
                              FontSize="11.5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="MinHeight" Value="30"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <!-- Cell.Background визуально накрывает Row.Background;
                                 триггеры на состояние Row-предка — hover/select работают,
                                 в отличие от Row.Style.Triggers, которые перебиваются
                                 SetCurrentValue(Background) внутри WPF DataGrid. -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg5Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ДОМЕН" Binding="{Binding Domain}" Width="*" MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ВОЗРАСТ" Binding="{Binding AgeText}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AgeColor}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ОСТАЛОСЬ" Binding="{Binding DaysLeftText}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding DaysLeftColor}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="RBL" Binding="{Binding RblText}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RblColor}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Content="⚙" Style="{StaticResource RowIconBtn}"
                                                    ToolTip="DNS-записи"
                                                    Command="{Binding DataContext.OpenRecordsCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Domain}"/>
                                            <Button Content="→" Style="{StaticResource RowIconBtn}"
                                                    ToolTip="Автоверификация в mail.ru"
                                                    Command="{Binding DataContext.MailRuVerifyCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Domain}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ══════════ BOTTOM-RIGHT: Домены в постмастере ══════════ -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}"
                    Padding="0" Margin="0,14,0,0">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="18,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Домены в постмастере"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="10" Padding="7,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Bg3Brush}">
                                <TextBlock FontSize="10.5"
                                           Foreground="{DynamicResource Fg2Brush}">
                                    <Run Text="{Binding PostmasterRows.Count, Mode=OneWay}"/>
                                    <Run Text=" дом."/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource RowIconBtn}"
                                Content="↻" ToolTip="Обновить"
                                Command="{Binding RefreshPostmasterCommand}"/>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" Padding="18,10"
                            BorderBrush="{DynamicResource Border1Brush}"
                            BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding PostmasterFooterText}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource Fg3Brush}"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="клик по строке — карточка"
                                       VerticalAlignment="Center"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding PostmasterRows}"
                              SelectedItem="{Binding SelectedPostmasterDomain, Mode=TwoWay}"
                              Margin="10,4,10,10"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ClipboardCopyMode="ExcludeHeader"
                              AlternationCount="2"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource Bg2Brush}"
                              Foreground="{DynamicResource Fg1Brush}"
                              FontSize="11.5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="MinHeight" Value="30"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg5Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <Style x:Key="NumCell" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ДОМЕН" Binding="{Binding Domain}" Width="*" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ПИСЬМА" Binding="{Binding MessagesSentText}" Width="65"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="ЖАЛОБ" Binding="{Binding ComplaintsText}" Width="55"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="РЕПУТ. %" Binding="{Binding ReputationPctText}" Width="65"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="ТЕНД. %" Binding="{Binding TrendText}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{Binding TrendFg}"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ПРОЧИТ." Binding="{Binding ReadText}" Width="60"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="УДАЛ.ПРОЧ." Binding="{Binding DeletedReadText}" Width="75"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="УДАЛ.НЕПР." Binding="{Binding DeletedUnreadText}" Width="75"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTemplateColumn Header="ДОСТАВЛЯЕМОСТЬ" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0"
                                                    ToolTip="{Binding DeliverabilityTooltip}">
                                            <!-- Доставлено (зелёный) -->
                                            <Border Height="16" CornerRadius="3,0,0,3"
                                                    Background="#22c55e"
                                                    Width="{Binding DeliveredBarWidth}"
                                                    ClipToBounds="True">
                                                <TextBlock Text="{Binding DeliveredPct, StringFormat={}{0:N1}}"
                                                           Foreground="White" FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeliveredBarWidth, Converter={StaticResource LessThan22}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Возможно спам (жёлтый) -->
                                            <Border Height="16"
                                                    Background="#eab308"
                                                    Width="{Binding ProbablySpamBarWidth}"
                                                    ClipToBounds="True">
                                                <TextBlock Text="{Binding ProbablySpamPct, StringFormat={}{0:N1}}"
                                                           Foreground="White" FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProbablySpamBarWidth, Converter={StaticResource LessThan22}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Спам (красный) -->
                                            <Border Height="16" CornerRadius="0,3,3,0"
                                                    Background="#ef4444"
                                                    Width="{Binding SpamBarWidth}"
                                                    ClipToBounds="True">
                                                <TextBlock Text="{Binding SpamPct, StringFormat={}{0:N1}}"
                                                           Foreground="White" FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SpamBarWidth, Converter={StaticResource LessThan22}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

    <!-- ═════════ DRAWER: карточка выбранного домена постмастера ═════════ -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Width="420"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource Border1Brush}"
            BorderThickness="1,0,0,0"
            Visibility="{Binding DrawerVisibility}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Padding="18,14"
                    BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕"
                            Style="{StaticResource RowIconBtn}"
                            FontSize="14"
                            ToolTip="Закрыть"
                            Command="{Binding CloseDrawerCommand}"/>
                    <TextBlock Text="{Binding SelectedPostmasterDomain.Domain, FallbackValue=''}"
                               FontSize="15" FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg1Brush}"/>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,18">
                    <DockPanel LastChildFill="False" Margin="0,0,0,8"
                               Visibility="{Binding DrawerTroublesVisibility}">
                        <TextBlock DockPanel.Dock="Left" Text="ПРОБЛЕМЫ"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg4Brush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SelectedPostmasterDomain.Troubles}"
                                  Margin="0,0,0,12"
                                  Visibility="{Binding DrawerTroublesVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6"
                                        CornerRadius="8"
                                        Background="{DynamicResource Bg2Brush}"
                                        BorderBrush="{DynamicResource Border1Brush}"
                                        BorderThickness="1">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" CornerRadius="4"
                                                Padding="6,2" Margin="0,0,10,0"
                                                Background="#1aef4444"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#ef4444"/>
                                        </Border>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Fg2Brush}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="СТАТИСТИКА ЗА ВСЁ ВРЕМЯ"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg4Brush}"
                               Margin="0,4,0,8"/>
                    <UniformGrid Columns="2" Rows="2">
                        <Border Padding="12,10" Margin="0,0,6,6" CornerRadius="8"
                                Background="{DynamicResource Bg2Brush}"
                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DrawerMessagesSent, FallbackValue='—'}"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Fg1Brush}"/>
                                <TextBlock Text="ОТПРАВЛЕНО ПИСЕМ" FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="12,10" Margin="6,0,0,6" CornerRadius="8"
                                Background="{DynamicResource Bg2Brush}"
                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DrawerDelivered, FallbackValue='—'}"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Fg1Brush}"/>
                                <TextBlock Text="ДОСТАВЛЕНО" FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="12,10" Margin="0,6,6,0" CornerRadius="8"
                                Background="{DynamicResource Bg2Brush}"
                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="Bold"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Fg1Brush}">
                                    <Run Text="{Binding DrawerSpamPercent, FallbackValue='—', Mode=OneWay}"/>
                                    <Run Text=" %" FontSize="13" FontWeight="Normal"
                                         Foreground="{DynamicResource Fg3Brush}"/>
                                </TextBlock>
                                <TextBlock Text="ДОЛЯ В «СПАМ»" FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="12,10" Margin="6,6,0,0" CornerRadius="8"
                                Background="{DynamicResource Bg2Brush}"
                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DrawerReputation, FallbackValue='—'}"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Fg1Brush}"/>
                                <TextBlock Text="РЕПУТАЦИЯ" FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ItemsControl ItemsSource="{Binding DrawerMetrics}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="0,5">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Value}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel LastChildFill="False" Margin="0,20,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="ГРАФИК ЗА 30 ДНЕЙ"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg4Brush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding DrawerChartRangeText, FallbackValue=''}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Fg4Brush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Padding="8" CornerRadius="8"
                            Background="{DynamicResource Bg2Brush}"
                            BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Нет данных"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource Fg4Brush}"
                                       Visibility="{Binding DrawerChartEmptyVisibility}"/>
                            <Image Height="160" Stretch="Uniform"
                                   Source="{Binding DrawerChartImage}"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding DrawerChartLegend}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Rectangle Width="10" Height="10"
                                               Fill="{Binding Color}"
                                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="10.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg2Brush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
    </Grid>
</UserControl>
