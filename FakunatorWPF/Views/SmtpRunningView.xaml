<UserControl x:Class="Fakunator.Views.SmtpRunningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
    <StackPanel Margin="20,12" x:Name="RootPanel">

        <!-- ── Progress card ──────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <!-- Big percentage -->
                    <TextBlock x:Name="TxtPercent" DockPanel.Dock="Left"
                               FontSize="28" FontWeight="Bold"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource Fg1Brush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Text="0.0%"/>

                    <!-- Processed / Total + Speed stacked -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProcessed" FontSize="13"
                                   Foreground="{DynamicResource Fg1Brush}"
                                   Text="0 / 0 обработано"/>
                        <TextBlock x:Name="TxtSpeed" FontSize="12"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,2,0,0"
                                   Text="скорость 0/с · 0 сессий"/>
                    </StackPanel>
                </DockPanel>

                <!-- Progress bar -->
                <Border Background="{DynamicResource Bg3Brush}" Height="8" CornerRadius="4"
                        ClipToBounds="True">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left"
                            Width="0" Height="8" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#5e6ad2" Offset="0"/>
                                <GradientStop Color="#818cf8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── KPI row: 6 cards ───────────────────────────────────── -->
        <UniformGrid Rows="1" Columns="6" Margin="0,0,0,10">
            <!-- ОБРАБОТАНО -->
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ОБРАБОТАНО" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiProcessed" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource Fg1Brush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ВАЛИДНЫЕ -->
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ВАЛИДНЫЕ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiValid" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="#22c55e"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- НЕДЕЙСТВИТЕЛЬНЫЕ -->
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="НЕДЕЙСТВИТЕЛЬНЫЕ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiInvalid" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="#ef4444"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- CATCH-ALL -->
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CATCH-ALL" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiCatchall" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="#eab308"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- НЕИЗВЕСТНЫЕ (4xx greylist / temp-fail) -->
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="НЕИЗВЕСТНЫЕ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiUnknown" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="#3b82f6"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ОШИБКИ -->
            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ОШИБКИ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiErrors" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="#71717a"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── Live feed card ─────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" MinHeight="180" MaxHeight="320" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse Width="6" Height="6" Fill="#22c55e"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Live" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg2Brush}"/>
                    <TextBlock Text=" · последние проверки" FontSize="10"
                               Foreground="{DynamicResource Fg3Brush}"/>
                </StackPanel>
                <ScrollViewer x:Name="FeedScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FeedPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Proxy monitor table ─────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <TextBlock Text="МОНИТОРИНГ ПРОКСИ" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,8"/>
                <!-- Header -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ПРОКСИ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg4Brush}"/>
                    <TextBlock Grid.Column="1" Text="OK" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg4Brush}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="ERR" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg4Brush}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="СТАТУС" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg4Brush}" HorizontalAlignment="Right"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Border1Brush}" Margin="0,0,0,4"/>
                <StackPanel x:Name="ProxyStatsPanel"/>
            </StackPanel>
        </Border>

        <!-- ── Bottom row: Stop button ────────────────────────────── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="&#x25A0;  Стоп" Style="{StaticResource DangerBtn}"
                    Padding="20,8" Click="OnStopClick"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
