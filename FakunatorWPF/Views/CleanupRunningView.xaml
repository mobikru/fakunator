<UserControl x:Class="Fakunator.Views.CleanupRunningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Fakunator.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
    <StackPanel Margin="20,12" x:Name="RootPanel">
        <!-- ── Progress card ──────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <!-- Big percentage -->
                    <TextBlock x:Name="TxtPercent" DockPanel.Dock="Left"
                               FontSize="28" FontWeight="Bold"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource Fg1Brush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Text="0.0%"/>

                    <!-- Processed / Total + Speed stacked -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProcessed" FontSize="13"
                                   Foreground="{DynamicResource Fg1Brush}"
                                   Text="0 / 0 обработано"/>
                        <TextBlock x:Name="TxtSpeed" FontSize="12"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,2,0,0"
                                   Text="скорость 0/с"/>
                    </StackPanel>
                </DockPanel>

                <!-- Progress bar -->
                <Border Background="{DynamicResource Bg3Brush}" Height="8" CornerRadius="4"
                        ClipToBounds="True">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left"
                            Width="0" Height="8" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#5e6ad2" Offset="0"/>
                                <GradientStop Color="#818cf8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── KPI row ────────────────────────────────────────────── -->
        <UniformGrid Rows="1" Columns="5" Margin="0,0,0,10">
            <!-- ОБРАБОТАНО -->
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ОБРАБОТАНО" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiProcessed" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource Fg1Brush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ВАЛИДНЫЕ -->
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ВАЛИДНЫЕ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiClean" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource CleanBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ОТКЛОНЁННЫЕ -->
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ОТКЛОНЁННЫЕ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiRejected" Text="0" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource DangerBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- СКОРОСТЬ -->
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="СКОРОСТЬ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiSpeed" Text="0/с" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource Fg1Brush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ВРЕМЯ -->
            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ВРЕМЯ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KpiElapsed" Text="00:00" FontSize="18"
                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource Fg1Brush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── Middle row: Provider legend + Sparkline + Live feed ── -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Provider donut legend card -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ПО ДОМЕНАМ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg3Brush}"
                               Margin="0,0,0,10"/>
                    <StackPanel x:Name="ProviderLegendPanel"/>
                </StackPanel>
            </Border>

            <!-- Right: Sparkline + Live feed stacked -->
            <StackPanel Grid.Column="2">
                <!-- Sparkline card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Height="140">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="СКОРОСТЬ ОБРАБОТКИ"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Margin="0,0,0,8"/>
                        <ctrl:SparklineChart x:Name="Sparkline" Height="80"/>
                    </DockPanel>
                </Border>

                <!-- Live feed card -->
                <Border Style="{StaticResource Card}" MinHeight="140" MaxHeight="220">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource CleanBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Live" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg2Brush}"/>
                            <TextBlock Text=" · последние обработанные" FontSize="10"
                                       Foreground="{DynamicResource Fg3Brush}"/>
                        </StackPanel>
                        <ScrollViewer x:Name="FeedScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="FeedPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── Counter cards grid (2 rows x 4 cols) ───────────────── -->
        <UniformGrid x:Name="CounterGrid" Rows="1" Columns="8" Margin="0,0,0,10"/>

        <!-- ── Bottom row: Stop button ────────────────────────────── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="&#x25A0;  Стоп" Style="{StaticResource DangerBtn}"
                    Padding="20,8" x:Name="BtnStop" Click="OnStopClick"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
