<UserControl x:Class="Fakunator.Views.AmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg1Brush}">

    <UserControl.Resources>
        <!-- ── Storyboards ─────────────────────────────────────────── -->
        <Storyboard x:Key="ShimmerLoop" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0.6" To="1.0" Duration="0:0:1.1" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="DotPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0.25" To="1.0" Duration="0:0:0.9" AutoReverse="True"/>
        </Storyboard>

        <!-- ── Chip-фильтр в левой колонке ─────────────────────────── -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" Background="{DynamicResource Bg3Brush}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource Bg2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Карточка рассылки в левом ListBox ───────────────────── -->
        <Style x:Key="MailingListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="wrap" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wrap" Property="Background" Value="{DynamicResource Bg2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="wrap" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Карточка секции в центре (С УЧЁТНОЙ ЗАПИСИ и т.п.) ── -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- ── Tile-стат (734 923 ОТПРАВЛЕНО) ──────────────────────── -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <!-- ── Цветные кнопки старт/стоп/пауза/с начала ──────────── -->
        <Style x:Key="StartBtn" TargetType="Button">
            <Setter Property="Background" Value="#22c55e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#16a34a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#15803d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RestartBtn" TargetType="Button" BasedOn="{StaticResource StartBtn}">
            <Setter Property="Background" Value="#f59e0b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#d97706"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#b45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource StartBtn}">
            <Setter Property="Background" Value="#ef4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#dc2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#b91c1c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PauseBtn" TargetType="Button" BasedOn="{StaticResource StartBtn}">
            <Setter Property="Background" Value="#71717a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#52525b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Grid tile 2×2 в правой панели ──────────────────────── -->
        <Style x:Key="RtTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header: заголовок + чип статуса + endpoint ═════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="AMS Enterprise" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Chip AMS API status -->
                <Border Background="{DynamicResource Bg2Brush}"
                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,4" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,7,0"
                                Background="{Binding StatusDot}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SchedulerRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource DotPulse}"/>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding EndpointText}" FontSize="11.5"
                           Foreground="{DynamicResource Fg4Brush}" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <!-- Кнопка «▶ Запустить планировщик» — видна только когда он остановлен -->
                <Button Content="▶ Запустить планировщик"
                        Command="{Binding StartSchedulerCommand}"
                        Style="{DynamicResource AccentBtn}"
                        Padding="12,5" FontSize="11" Margin="0,0,8,0"
                        Cursor="Hand"
                        ToolTip="Без планировщика рассылки не отправляются"
                        Visibility="{Binding SchedulerStopped, Converter={StaticResource BoolToVis}}"/>
                <Button Content="↻" Command="{Binding RefreshCommand}"
                        Style="{DynamicResource IconBtn}" ToolTip="Обновить"/>
                <Button Content="⚙" Command="{Binding OpenSettingsCommand}"
                        Style="{DynamicResource IconBtn}" Margin="4,0,0,0"
                        ToolTip="Настройки API"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══ Body: заглушка если AMS не настроен ═══════════════ -->
        <Border Grid.Row="1"
                Visibility="{Binding NoHostConfigured, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Bg2Brush}"
                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                CornerRadius="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <TextBlock Text="🛰" FontSize="56" HorizontalAlignment="Center" Opacity="0.35"/>
                <TextBlock Text="AMS Enterprise не подключён"
                           FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{DynamicResource Fg1Brush}"
                           Margin="0,14,0,6"/>
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource Fg3Brush}" LineHeight="19"
                           Text="Укажи хост AMS-сервера и API-ключ в настройках — после этого здесь появятся твои рассылки, учётные записи, списки адресов и профили отправки."/>
                <Button Content="⚙  Открыть настройки"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{DynamicResource AccentBtn}"
                        Padding="18,10" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Margin="0,20,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Body: 3 columns (только при настроенном AMS) ═══════ -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsHostConfigured, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: список рассылок ─────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                    CornerRadius="12">
                <DockPanel Margin="12,12,12,12">
                    <!-- Header + counter -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="ВАШИ РАССЫЛКИ" FontSize="10.5"
                                   FontWeight="SemiBold" Opacity="0.7"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" FontSize="10.5"
                                   Foreground="{DynamicResource Fg4Brush}"
                                   VerticalAlignment="Center" TextAlignment="Right">
                            <Run Text="{Binding CountAll, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding CountAll, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>

                    <!-- Search box -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Bg3Brush}"
                            CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" FontSize="11.5"
                                 Foreground="{DynamicResource Fg1Brush}"
                                 VerticalContentAlignment="Center"
                                 Tag="поиск рассылки"/>
                    </Border>

                    <!-- Filter chips -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton GroupName="AmsFilter" Style="{StaticResource FilterChip}"
                                     IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                     Command="{Binding SelectFilterCommand}" CommandParameter="all">
                            <TextBlock>
                                <Run Text="все "/>
                                <Run Text="{Binding CountAll, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="AmsFilter" Style="{StaticResource FilterChip}"
                                     IsChecked="{Binding IsFilterWorking, Mode=OneWay}"
                                     Command="{Binding SelectFilterCommand}" CommandParameter="working"
                                     Visibility="{Binding HasWorking, Converter={StaticResource BoolToVis}}">
                            <TextBlock>
                                <Run Text="идут "/>
                                <Run Text="{Binding CountWorking, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="AmsFilter" Style="{StaticResource FilterChip}"
                                     IsChecked="{Binding IsFilterRecent, Mode=OneWay}"
                                     Command="{Binding SelectFilterCommand}" CommandParameter="recent"
                                     ToolTip="Последние 20 запущенных рассылок">
                            <TextBlock>
                                <Run Text="недавние "/>
                                <Run Text="{Binding CountRecent, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer with actions -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border1Brush}"
                            BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="УПРАВЛЕНИЕ РАССЫЛКАМИ" FontSize="10"
                                       FontWeight="SemiBold" Opacity="0.7"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="+  Создать"
                                        Command="{Binding LaunchCampaignCommand}"
                                        Style="{DynamicResource AccentBtn}"
                                        Padding="14,8" FontSize="12" FontWeight="SemiBold"
                                        Cursor="Hand"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="✎" Style="{DynamicResource IconBtn}"
                                            Margin="6,0,0,0" ToolTip="Переименовать"
                                            Command="{Binding EditMailingCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Content="⧉" Style="{DynamicResource IconBtn}"
                                            Margin="4,0,0,0" ToolTip="Дублировать"
                                            Command="{Binding CloneMailingCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Content="🗑" Style="{DynamicResource IconBtn}"
                                            Margin="4,0,0,0" ToolTip="Удалить"
                                            Command="{Binding DeleteMailingCommand}"
                                            CommandParameter="{Binding SelectedMailing}"
                                            IsEnabled="{Binding HasSelection}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Main list -->
                    <ListBox ItemsSource="{Binding FilteredMailings}"
                             SelectedItem="{Binding SelectedMailing, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource MailingListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Accent bar (слева) — пульсирует для running -->
                                    <Border Grid.Column="0" Background="{Binding AccentBar}"
                                            CornerRadius="1.5" VerticalAlignment="Stretch"
                                            Margin="0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                                     From="0.35" To="1.0" Duration="0:0:0.85"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                        <DockPanel LastChildFill="False">
                                            <!-- Пульсирующая точка «идёт» — только для активных -->
                                            <Border DockPanel.Dock="Right" Width="7" Height="7"
                                                    CornerRadius="3.5" Background="#22c55e"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Border.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                                 From="0.25" To="1.0" Duration="0:0:0.85"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Fg1Brush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding CompactProgress}" FontSize="10"
                                                   Foreground="{DynamicResource Fg4Brush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg2Brush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ─── CENTER: детали активной рассылки ──────────────── -->
            <Grid Grid.Column="2">
                <!-- placeholder когда ничего не выбрано -->
                <Border Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Bg2Brush}"
                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📮" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="Выберите рассылку слева"
                                   Foreground="{DynamicResource Fg3Brush}" FontSize="14"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="или нажмите «Создать» чтобы запустить новую"
                                   Foreground="{DynamicResource Fg4Brush}" FontSize="11"
                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- основной вью деталей -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                              DataContext="{Binding SelectedMailing}">
                    <StackPanel>
                        <!-- ─ Header: name + chip state + action buttons ─ -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg1Brush}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Bg3Brush}"
                                        CornerRadius="10" Padding="8,3" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding StateColor}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Background="{DynamicResource Bg3Brush}"
                                        CornerRadius="8" Padding="14,7" Margin="0,0,8,0"
                                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,7,0"
                                                Background="#22c55e">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Border.Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource DotPulse}"/>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <TextBlock Text="Идёт отправка" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg1Brush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="⏸  Пауза"
                                        Command="{Binding DataContext.StopMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PauseBtn}"
                                        IsEnabled="{Binding CanStop}"/>
                                <Button Content="■  Стоп"
                                        Command="{Binding DataContext.StopMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource StopBtn}"
                                        Margin="6,0,0,0"
                                        IsEnabled="{Binding CanStop}"/>
                                <Button Content="▶  Старт"
                                        Command="{Binding DataContext.StartMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource StartBtn}"
                                        Margin="6,0,0,0"
                                        ToolTip="Продолжить с текущей позиции"
                                        Visibility="{Binding CanContinue, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="⟳  С начала"
                                        Command="{Binding DataContext.RestartMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource RestartBtn}"
                                        Margin="6,0,0,0"
                                        ToolTip="Стереть прогресс и запустить рассылку заново с первого адреса"
                                        Visibility="{Binding CanRestart, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Meta line -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Fg4Brush}">
                                <Run Text="ID "/>
                                <Run Text="{Binding DisplayId, Mode=OneWay}" Foreground="{DynamicResource Fg3Brush}"/>
                                <Run Text="   ·   обновлено "/>
                                <Run Text="{Binding UpdatedText, Mode=OneWay}" Foreground="{DynamicResource Fg3Brush}"/>
                                <Run Text="   ·   тип "/>
                                <Run Text="{Binding TypeText, Mode=OneWay}" Foreground="{DynamicResource Fg3Brush}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Row of 4 configuration cards 2×2 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sender account -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="👤  С УЧЁТНОЙ ЗАПИСИ" FontSize="10.5"
                                                   FontWeight="SemiBold" Opacity="0.8"
                                                   Foreground="{DynamicResource Fg3Brush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="SMTP ok" FontSize="10"
                                                   Foreground="#22c55e" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ComboBox ItemsSource="{Binding DataContext.SenderAccounts,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding DataContext.SelectedSender,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              DisplayMemberPath="AccountName"
                                              Height="32" FontSize="12"
                                              Background="{DynamicResource Bg3Brush}"
                                              BorderBrush="{DynamicResource Border1Brush}"
                                              Foreground="{DynamicResource Fg1Brush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Mailing list -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="🎯  НА СПИСОК АДРЕСОВ" FontSize="10.5"
                                                   FontWeight="SemiBold" Opacity="0.8"
                                                   Foreground="{DynamicResource Fg3Brush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalCompact, StringFormat={}{0} адр.}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Fg4Brush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ComboBox ItemsSource="{Binding DataContext.FlatMailingLists,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding DataContext.SelectedList,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              Height="32" FontSize="12"
                                              Background="{DynamicResource Bg3Brush}"
                                              BorderBrush="{DynamicResource Border1Brush}"
                                              Foreground="{DynamicResource Fg1Brush}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="{Binding IndentPx}"/>
                                                    <TextBlock Text="›  " Foreground="{DynamicResource Fg4Brush}"
                                                               Visibility="{Binding Depth,
                                                                    Converter={StaticResource IntGtZeroToVis}}"/>
                                                    <TextBlock Text="{Binding ListName}"
                                                               Foreground="{DynamicResource Fg1Brush}"/>
                                                    <TextBlock Foreground="{DynamicResource Fg4Brush}" FontSize="10"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="{Binding Size, StringFormat={}· {0:N0} адр.}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Message -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="✉  ПОСЛАТЬ ПИСЬМО" FontSize="10.5"
                                                   FontWeight="SemiBold" Opacity="0.8"
                                                   Foreground="{DynamicResource Fg3Brush}"/>
                                        <Button DockPanel.Dock="Right" Content="👁 Просмотр"
                                                Padding="10,3" FontSize="10.5" Cursor="Hand"
                                                Command="{Binding DataContext.PreviewMessageCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{DynamicResource GhostBtn}"
                                                ToolTip="Открыть письмо в окне превью (WebView2)"/>
                                    </DockPanel>
                                    <ComboBox ItemsSource="{Binding DataContext.Messages,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding DataContext.SelectedMessage,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              DisplayMemberPath="MessageName"
                                              Height="32" FontSize="12"
                                              Background="{DynamicResource Bg3Brush}"
                                              BorderBrush="{DynamicResource Border1Brush}"
                                              Foreground="{DynamicResource Fg1Brush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Delivery preset -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="⚙  ПРОФИЛЬ ОТПРАВКИ" FontSize="10.5"
                                                   FontWeight="SemiBold" Opacity="0.8"
                                                   Foreground="{DynamicResource Fg3Brush}"/>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding DataContext.SelectedPresetThreadsText,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Fg4Brush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ComboBox ItemsSource="{Binding DataContext.DeliveryPresets,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding DataContext.SelectedPreset,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Height="32" FontSize="12"
                                              Background="{DynamicResource Bg3Brush}"
                                              BorderBrush="{DynamicResource Border1Brush}"
                                              Foreground="{DynamicResource Fg1Brush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ─ Progress card (полная ширина, shimmer, блик) ─ -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ПРОГРЕСС ОТПРАВКИ" FontSize="10.5"
                                               FontWeight="SemiBold" Opacity="0.8"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid x:Name="ProgHost" Height="22" ClipToBounds="True">
                                    <!-- track -->
                                    <Border Background="{DynamicResource Bg3Brush}" CornerRadius="11"/>
                                    <!-- fill: ширина = ActualWidth × PercentFraction через MultiBinding -->
                                    <Border HorizontalAlignment="Left" CornerRadius="11">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentWidth}">
                                                <Binding Path="PercentFraction"/>
                                                <Binding Path="ActualWidth" ElementName="ProgHost"/>
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#5e6ad2" Offset="0"/>
                                                <GradientStop Color="#818cf8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Блик — двигающийся LinearGradient. Только для working. -->
                                    <Border HorizontalAlignment="Left" CornerRadius="11" IsHitTestVisible="False"
                                            Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentWidth}">
                                                <Binding Path="PercentFraction"/>
                                                <Binding Path="ActualWidth" ElementName="ProgHost"/>
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop x:Name="shineA" Color="#00FFFFFF" Offset="0.35"/>
                                                <GradientStop x:Name="shineB" Color="#66FFFFFF" Offset="0.5"/>
                                                <GradientStop x:Name="shineC" Color="#00FFFFFF" Offset="0.65"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="shineA"
                                                                         Storyboard.TargetProperty="Offset"
                                                                         From="-0.3" To="1.0" Duration="0:0:1.8"/>
                                                        <DoubleAnimation Storyboard.TargetName="shineB"
                                                                         Storyboard.TargetProperty="Offset"
                                                                         From="-0.15" To="1.15" Duration="0:0:1.8"/>
                                                        <DoubleAnimation Storyboard.TargetName="shineC"
                                                                         Storyboard.TargetProperty="Offset"
                                                                         From="0.0" To="1.3" Duration="0:0:1.8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <TextBlock Text="{Binding PercentText}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="11"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Statistic tiles row -->
                        <UniformGrid Rows="1" Margin="0,0,0,12">
                            <Border Style="{StaticResource StatTile}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sent, Mode=OneWay, StringFormat={}{0:N0}}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="#22c55e"/>
                                    <TextBlock Text="ОТПРАВЛЕНО" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0}}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="ВСЕГО ПИСЕМ" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding NotSent, Mode=OneWay, StringFormat={}{0:N0}}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="#ef4444"/>
                                    <TextBlock Text="НЕ ОТПРАВЛЕНО" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Bad, Mode=OneWay, StringFormat={}{0:N0}}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="#f59e0b"/>
                                    <TextBlock Text="ПЛОХИХ АДРЕСОВ" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Refused, Mode=OneWay, StringFormat={}{0:N0}}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="НЕ ПРИНЯТЫХ" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Excluded, Mode=OneWay, StringFormat={}{0:N0}}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="ИСКЛЮЧЕНО" FontSize="9.5" Opacity="0.7"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg4Brush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ─── RIGHT: realtime + профиль ─────────────────────── -->
            <StackPanel Grid.Column="4"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <!-- Realtime tile grid -->
                <TextBlock Text="REALTIME СТАТИСТИКА" FontSize="10.5"
                           FontWeight="SemiBold" Opacity="0.7"
                           Foreground="{DynamicResource Fg3Brush}"
                           Margin="0,0,0,10"/>
                <UniformGrid Columns="2" Rows="2" DataContext="{Binding SelectedMailing}">
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <TextBlock Text="👁" FontSize="14" Opacity="0.6"/>
                            <TextBlock Text="{Binding Opened, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="#3b82f6" Margin="0,4,0,2"/>
                            <TextBlock Text="ПИСЕМ ОТКРЫТО" FontSize="9" Opacity="0.7"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <TextBlock Text="🔗" FontSize="14" Opacity="0.6"/>
                            <TextBlock Text="{Binding Clicks, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="#8b5cf6" Margin="0,4,0,2"/>
                            <TextBlock Text="КЛИКОВ НА ССЫЛКИ" FontSize="9" Opacity="0.7"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <TextBlock Text="↩" FontSize="14" Opacity="0.6"/>
                            <TextBlock Text="{Binding UnsubscribeCount, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="#ef4444" Margin="0,4,0,2"/>
                            <TextBlock Text="ОТПИСОК" FontSize="9" Opacity="0.7"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <TextBlock Text="⚡" FontSize="14" Opacity="0.6"/>
                            <TextBlock Text="{Binding SpeedText}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#22c55e" Margin="0,4,0,2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="СКОРОСТЬ" FontSize="9" Opacity="0.7"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Delivery preset details -->
                <DockPanel Margin="0,16,0,10">
                    <TextBlock Text="ПРОФИЛЬ ОТПРАВКИ" FontSize="10.5"
                               FontWeight="SemiBold" Opacity="0.7"
                               Foreground="{DynamicResource Fg3Brush}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding SelectedPresetName}"
                               FontSize="10.5"
                               Foreground="{DynamicResource Fg4Brush}"
                               VerticalAlignment="Center" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetThreads}" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock Text="ПОТОКОВ" FontSize="9" Opacity="0.7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetMethod}" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="МЕТОД" FontSize="9" Opacity="0.7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetMode}" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="РЕЖИМ ДОСТАВКИ" FontSize="9" Opacity="0.7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetProxy}" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock Text="ПРОКСИ" FontSize="9" Opacity="0.7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{Binding SelectedSenderEmail}" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="ОТПРАВИТЕЛЬ" FontSize="9" Opacity="0.7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="{Binding SelectedSenderReply}" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="REPLY-TO" FontSize="9" Opacity="0.7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
