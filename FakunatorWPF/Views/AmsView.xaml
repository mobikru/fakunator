<UserControl x:Class="Fakunator.Views.AmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Fakunator.Core"
             Background="{DynamicResource Bg1Brush}">

    <UserControl.Resources>
        <!-- ── Storyboards ─────────────────────────────────────────── -->
        <Storyboard x:Key="ShimmerLoop" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0.6" To="1.0" Duration="0:0:1.1" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="DotPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0.25" To="1.0" Duration="0:0:0.9" AutoReverse="True"/>
        </Storyboard>

        <!-- ═══ Стиль раздела «Серверы»: белые карточки, скруглённые углы, мягкая тень,
             единый класс кнопок ActionBtn*. См. FakunatorWPF/Views/ServerInstallView.xaml. ═══ -->

        <!-- ── Chip-фильтр в левой колонке (все / идут / недавние) ─── -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7582A3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" Background="#F6F7FB" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#ECEFF5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#EEF1FB"/>
                                <Setter Property="Foreground" Value="#4b5bff"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Строка рассылки в левом ListBox ─────────────────────── -->
        <Style x:Key="MailingListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="wrap" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wrap" Property="Background" Value="#F6F7FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="wrap" Property="Background" Value="#EEF1FB"/>
                                <Setter TargetName="wrap" Property="BorderBrush" Value="#D5DCF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Белая карточка-секция (С УЧЁТНОЙ ЗАПИСИ и т.п.) ─────── -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- ── Icon-chip тайл-метрика (как CPU/RAM/DISK в Серверах) ─── -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1e293b" Direction="270" ShadowDepth="1.5" BlurRadius="10" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Grid tile 2×2 в правой панели (realtime) ────────────── -->
        <Style x:Key="RtTile" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <!-- ═══ Кастомный выпадающий список адресных баз (папки/списки) ═══ -->

        <!-- Строка одного узла: папка (жирный, иконка папки, без ⋮) или список (файл + счётчик + ⋮) -->
        <DataTemplate x:Key="MailingListItemTemplate">
            <Border x:Name="rowRoot" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="{Binding IndentPx}"/>
                    <Viewbox Grid.Column="1" Width="14" Height="14" Margin="0,0,7,0">
                        <Path x:Name="icon" Data="{x:Static core:PhosphorIcons.FileText}" Fill="#7582A3"/>
                    </Viewbox>
                    <TextBlock x:Name="nameText" Grid.Column="2" Text="{Binding ListName}" FontSize="12"
                               Foreground="#131C3D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="10.5" Foreground="#7582A3"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Viewbox x:Name="kebab" Grid.Column="4" Width="12" Height="12" Margin="8,0,0,0" Opacity="0">
                        <Path Data="{x:Static core:PhosphorIcons.DotsThreeVertical}" Fill="#7582A3"/>
                    </Viewbox>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="icon" Property="Data" Value="{x:Static core:PhosphorIcons.Folder}"/>
                    <Setter TargetName="icon" Property="Fill" Value="#3B82F6"/>
                    <Setter TargetName="nameText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter TargetName="kebab" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <Trigger SourceName="rowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="rowRoot" Property="Background" Value="#F6F7FB"/>
                    <Setter TargetName="kebab" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Контейнер строки: без системной синей подсветки, свои hover/selected -->
        <Style x:Key="MailingListComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E8EDFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Полный шаблон ComboBox: закрытая коробка (простой текст) + попап
             с заголовком «Списки рассылки» и деревом папок/списков ниже. -->
        <ControlTemplate x:Key="MailingListComboTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="mainBox" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="10,0,4,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="#131C3D" TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedItem.ListName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue='—'}"/>
                        <Viewbox Grid.Column="1" Width="10" Height="10" Margin="0,0,10,0">
                            <Path Data="{x:Static core:PhosphorIcons.CaretDown}" Fill="#7582A3"/>
                        </Viewbox>
                    </Grid>
                </Border>
                <ToggleButton Background="Transparent" Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                       PlacementTarget="{Binding ElementName=mainBox}" Placement="Bottom"
                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False" Focusable="False">
                    <Border Background="White" BorderBrush="#E4E7EF" BorderThickness="1"
                            CornerRadius="10" Width="{Binding ActualWidth, ElementName=mainBox}"
                            Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#1e293b" Direction="270" ShadowDepth="2" BlurRadius="16" Opacity="0.16"/>
                        </Border.Effect>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#F6F7FB" CornerRadius="10,10,0,0"
                                    BorderBrush="#E4E7EF" BorderThickness="0,0,0,1" Padding="12,9">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{core:Tr ams.combo.listsTitle}" FontSize="11"
                                               FontWeight="Bold" Foreground="#131C3D" VerticalAlignment="Center"/>
                                    <Viewbox DockPanel.Dock="Right" Width="9" Height="9" Margin="6,0,0,0">
                                        <Path Data="{x:Static core:PhosphorIcons.CaretDown}" Fill="#7582A3">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="180" CenterX="128" CenterY="128"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Viewbox>
                                    <TextBlock DockPanel.Dock="Right" FontSize="10.5" Foreground="#7582A3"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding ItemsSource.Count, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                                        <Run Text="{core:Tr ams.combo.listsCountSuffix}"/>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Margin="4,4,4,6"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="MailingListCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#F6F7FB"/>
            <Setter Property="BorderBrush" Value="#E4E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#131C3D"/>
            <Setter Property="ItemTemplate" Value="{StaticResource MailingListItemTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MailingListComboItem}"/>
            <Setter Property="Template" Value="{StaticResource MailingListComboTemplate}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header: заголовок + чип статуса + endpoint ═════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EF" BorderThickness="1"
                CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#eef1fb" Margin="0,0,10,0">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{x:Static core:PhosphorIcons.Envelope}" Fill="#4b5bff"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{core:Tr ams.header.title}" FontSize="17" FontWeight="Bold"
                               Foreground="#131C3D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- Chip AMS API status -->
                    <Border Background="#F6F7FB" BorderBrush="#E4E7EF" BorderThickness="1"
                            CornerRadius="14" Padding="10,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,7,0"
                                    Background="{Binding StatusDot}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SchedulerRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource DotPulse}"/>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="#131C3D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding EndpointText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#131C3D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Кнопка «Запустить планировщик» — видна только когда он остановлен -->
                    <Button Content="{core:Tr ams.header.btnStartScheduler}"
                            Command="{Binding StartSchedulerCommand}"
                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Play}"
                            Style="{StaticResource ActionBtnGreen}"
                            Margin="0,0,8,0"
                            ToolTip="{core:Tr ams.header.btnStartSchedulerTooltip}"
                            Visibility="{Binding SchedulerStopped, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{core:Tr ams.header.btnRefresh}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ActionBtnPrimary}"
                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.ArrowClockwise}"
                            Margin="0,0,8,0"/>
                    <Button Content="{core:Tr ams.header.btnSettings}" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource ActionBtnNeutral}"
                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Gear}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Body: заглушка если AMS не настроен ═══════════════ -->
        <Border Grid.Row="1"
                Visibility="{Binding NoHostConfigured, Converter={StaticResource BoolToVis}}"
                Background="White" BorderBrush="#E4E7EF" BorderThickness="1" CornerRadius="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <Viewbox Width="52" Height="52" Opacity="0.35">
                    <Path Data="{x:Static core:PhosphorIcons.Envelope}" Fill="#4b5bff"/>
                </Viewbox>
                <TextBlock Text="{core:Tr ams.header.notConnectedTitle}"
                           FontSize="18" FontWeight="Bold" TextAlignment="Center"
                           Foreground="#131C3D" Margin="0,14,0,6"/>
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="#7582A3" LineHeight="19"
                           Text="{core:Tr ams.header.notConnectedDesc}"/>
                <Button Content="{core:Tr ams.header.btnOpenSettings}"
                        Command="{Binding OpenSettingsCommand}"
                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Gear}"
                        Style="{StaticResource ActionBtnGreen}"
                        Padding="18,10" FontSize="13"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Body: 3 columns (только при настроенном AMS) ═══════ -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsHostConfigured, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: список рассылок ─────────────────────────── -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E4E7EF" BorderThickness="1" CornerRadius="12">
                <DockPanel Margin="12,12,12,12">
                    <!-- Header + counter -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{core:Tr ams.left.header}" FontSize="10.5"
                                   FontWeight="SemiBold" Opacity="0.75"
                                   Foreground="#7582A3" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" FontSize="10.5"
                                   Foreground="#7582A3" VerticalAlignment="Center" TextAlignment="Right">
                            <Run Text="{Binding CountAll, Mode=OneWay}"/>
                            <Run Text="{core:Tr ams.left.countSep}"/>
                            <Run Text="{Binding CountAll, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>

                    <!-- Search box -->
                    <Border DockPanel.Dock="Top" Background="#F6F7FB" BorderBrush="#E4E7EF" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,7,0" Opacity="0.6">
                                <Path Data="{x:Static core:PhosphorIcons.Globe}" Fill="#7582A3"/>
                            </Viewbox>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="11.5"
                                     Foreground="#131C3D" VerticalContentAlignment="Center"
                                     Tag="{core:Tr ams.left.searchPlaceholder}"/>
                        </DockPanel>
                    </Border>

                    <!-- Filter chips -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton GroupName="AmsFilter" Style="{StaticResource FilterChip}"
                                     IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                     Command="{Binding SelectFilterCommand}" CommandParameter="all">
                            <TextBlock>
                                <Run Text="{core:Tr ams.left.filterAll}"/>
                                <Run Text="{Binding CountAll, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="AmsFilter" Style="{StaticResource FilterChip}"
                                     IsChecked="{Binding IsFilterWorking, Mode=OneWay}"
                                     Command="{Binding SelectFilterCommand}" CommandParameter="working"
                                     Visibility="{Binding HasWorking, Converter={StaticResource BoolToVis}}">
                            <TextBlock>
                                <Run Text="{core:Tr ams.left.filterWorking}"/>
                                <Run Text="{Binding CountWorking, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="AmsFilter" Style="{StaticResource FilterChip}"
                                     IsChecked="{Binding IsFilterRecent, Mode=OneWay}"
                                     Command="{Binding SelectFilterCommand}" CommandParameter="recent"
                                     ToolTip="{core:Tr ams.left.filterRecentTooltip}">
                            <TextBlock>
                                <Run Text="{core:Tr ams.left.filterRecent}"/>
                                <Run Text="{Binding CountRecent, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer with actions -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="#E4E7EF"
                            BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{core:Tr ams.left.manageHeader}" FontSize="10"
                                       FontWeight="SemiBold" Opacity="0.75"
                                       Foreground="#7582A3" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="{core:Tr ams.left.btnCreate}"
                                        Command="{Binding LaunchCampaignCommand}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Plus}"
                                        Style="{StaticResource ActionBtnGreen}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionBtnNeutral}" Content=""
                                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.PencilSimple}"
                                            Padding="9,9" Margin="6,0,0,0" ToolTip="{core:Tr ams.left.tooltipRename}"
                                            Command="{Binding EditMailingCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Style="{StaticResource ActionBtnNeutral}" Content=""
                                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Copy}"
                                            Padding="9,9" Margin="6,0,0,0" ToolTip="{core:Tr ams.left.tooltipClone}"
                                            Command="{Binding CloneMailingCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Style="{StaticResource ActionBtnDanger}" Content=""
                                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Trash}"
                                            Padding="9,9" Margin="6,0,0,0" ToolTip="{core:Tr ams.left.tooltipDelete}"
                                            Command="{Binding DeleteMailingCommand}"
                                            CommandParameter="{Binding SelectedMailing}"
                                            IsEnabled="{Binding HasSelection}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Main list -->
                    <ListBox ItemsSource="{Binding FilteredMailings}"
                             SelectedItem="{Binding SelectedMailing, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource MailingListItem}"
                             Background="Transparent" BorderThickness="0" Padding="0,0,8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Accent bar (слева) — пульсирует для running -->
                                    <Border Grid.Column="0" Background="{Binding AccentBar}"
                                            CornerRadius="1.5" VerticalAlignment="Stretch"
                                            Margin="0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                                     From="0.35" To="1.0" Duration="0:0:0.85"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                        <DockPanel LastChildFill="False">
                                            <!-- Пульсирующая точка «идёт» — только для активных -->
                                            <Border DockPanel.Dock="Right" Width="7" Height="7"
                                                    CornerRadius="3.5" Background="#22c55e"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Border.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                                 From="0.25" To="1.0" Duration="0:0:0.85"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#131C3D"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding CompactProgress}" FontSize="10"
                                                   Foreground="#7582A3" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#131C3D" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ─── CENTER: детали активной рассылки — единый белый блок, как в Серверах ─ -->
            <Grid Grid.Column="2">
                <!-- placeholder когда ничего не выбрано -->
                <Border Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}"
                        Background="White" BorderBrush="#E4E7EF" BorderThickness="1" CornerRadius="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="38" Height="38" Opacity="0.35">
                            <Path Data="{x:Static core:PhosphorIcons.Envelope}" Fill="#4b5bff"/>
                        </Viewbox>
                        <TextBlock Text="{core:Tr ams.center.emptyTitle}"
                                   Foreground="#7582A3" FontSize="14"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="{core:Tr ams.center.emptyDesc}"
                                   Foreground="#7582A3" Opacity="0.8" FontSize="11"
                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- основной вью деталей -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                              DataContext="{Binding SelectedMailing}">
                    <StackPanel Margin="2,0,2,4">
                        <!-- ═══ Блок 1: выбор списков (заголовок + 4 карточки конфигурации) ═══ -->
                        <Border Background="White" BorderBrush="#E4E7EF" BorderThickness="1"
                                CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                        <!-- ─ Header: name + chip state + action buttons ─ -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                           Foreground="#131C3D" VerticalAlignment="Center"/>
                                <Border Background="#F6F7FB" CornerRadius="10" Padding="8,3"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{Binding StateColor}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Background="#F6F7FB" CornerRadius="8" Padding="14,7" Margin="0,0,8,0"
                                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,7,0"
                                                Background="#22c55e">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Border.Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource DotPulse}"/>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <TextBlock Text="{core:Tr ams.center.sentBadge}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="#131C3D"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="{core:Tr ams.center.btnPause}"
                                        Command="{Binding DataContext.StopMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Pause}"
                                        Style="{StaticResource ActionBtnNeutral}"
                                        IsEnabled="{Binding CanStop}"/>
                                <Button Content="{core:Tr ams.center.btnStop}"
                                        Command="{Binding DataContext.StopMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Stop}"
                                        Style="{StaticResource ActionBtnNeutral}"
                                        Margin="6,0,0,0"
                                        IsEnabled="{Binding CanStop}"/>
                                <Button Content="{core:Tr ams.center.btnStart}"
                                        Command="{Binding DataContext.StartMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Play}"
                                        Style="{StaticResource ActionBtnGreen}"
                                        Margin="6,0,0,0"
                                        ToolTip="{core:Tr ams.center.btnStartTooltip}"
                                        Visibility="{Binding CanContinue, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="{core:Tr ams.center.btnRestart}"
                                        Command="{Binding DataContext.RestartMailingCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.ArrowClockwise}"
                                        Style="{StaticResource ActionBtnDanger}"
                                        Margin="6,0,0,0"
                                        ToolTip="{core:Tr ams.center.btnRestartTooltip}"
                                        Visibility="{Binding CanRestart, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Meta line -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock FontSize="11" Foreground="#7582A3">
                                <Run Text="{core:Tr ams.center.metaId}"/>
                                <Run Text="{Binding DisplayId, Mode=OneWay}" Foreground="#131C3D"/>
                                <Run Text="{core:Tr ams.center.metaUpdatedSep}"/>
                                <Run Text="{Binding UpdatedText, Mode=OneWay}" Foreground="#131C3D"/>
                                <Run Text="{core:Tr ams.center.metaTypeSep}"/>
                                <Run Text="{Binding TypeText, Mode=OneWay}" Foreground="#131C3D"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Row of 4 configuration cards 2×2 -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sender account -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCard}" Padding="2,6,14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="78" ClipToBounds="True"
                                            HorizontalAlignment="Left" Margin="-10,0,0,0">
                                        <Image Source="pack://application:,,,/Assets/AmsIcons/mail.png"
                                               Width="180" Stretch="Uniform" IsHitTestVisible="False"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel Margin="0,0,0,6" MinHeight="24" LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                                    <Path Data="{x:Static core:PhosphorIcons.Envelope}" Fill="#7582A3"/>
                                                </Viewbox>
                                                <TextBlock Text="{core:Tr ams.card.sender.label}" FontSize="10.5"
                                                           FontWeight="SemiBold" Opacity="0.8" Foreground="#7582A3"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{core:Tr ams.card.sender.smtpOk}" FontSize="10"
                                                       Foreground="#22c55e" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding DataContext.SenderAccounts,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataContext.SelectedSender,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  DisplayMemberPath="AccountName"
                                                  Height="32" FontSize="12"
                                                  Background="#F6F7FB" BorderBrush="#E4E7EF" Foreground="#131C3D"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Mailing list -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCard}" Padding="2,6,14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="78" ClipToBounds="True"
                                            HorizontalAlignment="Left" Margin="-10,0,0,0">
                                        <Image Source="pack://application:,,,/Assets/AmsIcons/contacts.png"
                                               Width="180" Stretch="Uniform" IsHitTestVisible="False"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel Margin="0,0,0,6" MinHeight="24" LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                                    <Path Data="{x:Static core:PhosphorIcons.ChartBar}" Fill="#7582A3"/>
                                                </Viewbox>
                                                <TextBlock Text="{core:Tr ams.card.list.label}" FontSize="10.5"
                                                           FontWeight="SemiBold" Opacity="0.8" Foreground="#7582A3"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       FontSize="10" Foreground="#7582A3" VerticalAlignment="Center">
                                                <Run Text="{Binding TotalCompact, Mode=OneWay}"/>
                                                <Run Text="{core:Tr ams.card.list.countSuffix}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding DataContext.FlatMailingLists,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataContext.SelectedList,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  Height="32" FontSize="12"
                                                  Style="{StaticResource MailingListCombo}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Message -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionCard}" Padding="2,6,14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="78" ClipToBounds="True"
                                            HorizontalAlignment="Left" Margin="-10,0,0,0">
                                        <Image Source="pack://application:,,,/Assets/AmsIcons/paperplane.png"
                                               Width="180" Stretch="Uniform" IsHitTestVisible="False"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel Margin="0,0,0,6" MinHeight="24" LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                                    <Path Data="{x:Static core:PhosphorIcons.FileText}" Fill="#7582A3"/>
                                                </Viewbox>
                                                <TextBlock Text="{core:Tr ams.card.message.label}" FontSize="10.5"
                                                           FontWeight="SemiBold" Opacity="0.8" Foreground="#7582A3"/>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="{core:Tr ams.card.message.btnPreview}" VerticalAlignment="Center"
                                                    core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Eye}"
                                                    Style="{StaticResource ActionBtnNeutral}"
                                                    Padding="10,3" FontSize="10.5"
                                                    Command="{Binding DataContext.PreviewMessageCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="{core:Tr ams.card.message.previewTooltip}"/>
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding DataContext.Messages,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataContext.SelectedMessage,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  DisplayMemberPath="MessageName"
                                                  Height="32" FontSize="12"
                                                  Background="#F6F7FB" BorderBrush="#E4E7EF" Foreground="#131C3D"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Delivery preset -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SectionCard}" Padding="2,6,14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="78" ClipToBounds="True"
                                            HorizontalAlignment="Left" Margin="-10,0,0,0">
                                        <Image Source="pack://application:,,,/Assets/AmsIcons/gear.png"
                                               Width="180" Stretch="Uniform" IsHitTestVisible="False"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel Margin="0,0,0,6" MinHeight="24" LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                                    <Path Data="{x:Static core:PhosphorIcons.Gear}" Fill="#7582A3"/>
                                                </Viewbox>
                                                <TextBlock Text="{core:Tr ams.card.preset.label}" FontSize="10.5"
                                                           FontWeight="SemiBold" Opacity="0.8" Foreground="#7582A3"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding DataContext.SelectedPresetThreadsText,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="10" Foreground="#7582A3" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding DataContext.DeliveryPresets,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataContext.SelectedPreset,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  Height="32" FontSize="12"
                                                  Background="#F6F7FB" BorderBrush="#E4E7EF" Foreground="#131C3D"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        </StackPanel>
                        </Border>

                        <!-- ═══ Блок 2: прогресс отправки ═══ -->
                        <Border Background="White" BorderBrush="#E4E7EF" BorderThickness="1"
                                CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                            <Path Data="{x:Static core:PhosphorIcons.ChartBar}" Fill="#7582A3"/>
                                        </Viewbox>
                                        <TextBlock Text="{core:Tr ams.progress.header}" FontSize="10.5"
                                                   FontWeight="SemiBold" Opacity="0.8"
                                                   VerticalAlignment="Center" Foreground="#7582A3"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="#131C3D"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid x:Name="ProgHost" Height="22" ClipToBounds="True">
                                    <!-- track -->
                                    <Border Background="#F0F2F8" CornerRadius="11"/>
                                    <!-- fill: ширина = ActualWidth × PercentFraction через MultiBinding -->
                                    <Border HorizontalAlignment="Left" CornerRadius="11">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentWidth}">
                                                <Binding Path="PercentFraction"/>
                                                <Binding Path="ActualWidth" ElementName="ProgHost"/>
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#5e6ad2" Offset="0"/>
                                                <GradientStop Color="#818cf8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Блик — двигающийся LinearGradient. Только для working. -->
                                    <Border HorizontalAlignment="Left" CornerRadius="11" IsHitTestVisible="False"
                                            Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentWidth}">
                                                <Binding Path="PercentFraction"/>
                                                <Binding Path="ActualWidth" ElementName="ProgHost"/>
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop x:Name="shineA" Color="#00FFFFFF" Offset="0.35"/>
                                                <GradientStop x:Name="shineB" Color="#66FFFFFF" Offset="0.5"/>
                                                <GradientStop x:Name="shineC" Color="#00FFFFFF" Offset="0.65"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="shineA"
                                                                         Storyboard.TargetProperty="Offset"
                                                                         From="-0.3" To="1.0" Duration="0:0:1.8"/>
                                                        <DoubleAnimation Storyboard.TargetName="shineB"
                                                                         Storyboard.TargetProperty="Offset"
                                                                         From="-0.15" To="1.15" Duration="0:0:1.8"/>
                                                        <DoubleAnimation Storyboard.TargetName="shineC"
                                                                         Storyboard.TargetProperty="Offset"
                                                                         From="0.0" To="1.3" Duration="0:0:1.8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <TextBlock Text="{Binding PercentText}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="11"
                                               Foreground="#7582A3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Блок 3: виджеты (статистика рассылки) ═══ -->
                        <Border Background="White" BorderBrush="#E4E7EF" BorderThickness="1"
                                CornerRadius="12" Padding="10">
                        <UniformGrid Columns="3" Rows="2">
                            <Border Style="{StaticResource StatTile}" Margin="6" Padding="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#E7F9EE">
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{x:Static core:PhosphorIcons.PaperPlane}" Fill="#16A34A"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sent, Mode=OneWay, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#131C3D"/>
                                        <TextBlock Text="{core:Tr ams.stats.sent}" FontSize="10" Opacity="0.85"
                                                   FontWeight="SemiBold" Foreground="#7582A3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6" Padding="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#E8F0FE">
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{x:Static core:PhosphorIcons.FileText}" Fill="#2563EB"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#131C3D"/>
                                        <TextBlock Text="{core:Tr ams.stats.total}" FontSize="10" Opacity="0.85"
                                                   FontWeight="SemiBold" Foreground="#7582A3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6" Padding="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#FDEEEE">
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{x:Static core:PhosphorIcons.XCircle}" Fill="#ef4444"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NotSent, Mode=OneWay, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#131C3D"/>
                                        <TextBlock Text="{core:Tr ams.stats.notSent}" FontSize="10" Opacity="0.85"
                                                   FontWeight="SemiBold" Foreground="#7582A3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6" Padding="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#FEF3E0">
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{x:Static core:PhosphorIcons.Warning}" Fill="#D97706"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Bad, Mode=OneWay, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#131C3D"/>
                                        <TextBlock Text="{core:Tr ams.stats.bad}" FontSize="10" Opacity="0.85"
                                                   FontWeight="SemiBold" Foreground="#7582A3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6" Padding="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#E8F0FE">
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{x:Static core:PhosphorIcons.Clock}" Fill="#2563EB"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Refused, Mode=OneWay, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#131C3D"/>
                                        <TextBlock Text="{core:Tr ams.stats.refused}" FontSize="10" Opacity="0.85"
                                                   FontWeight="SemiBold" Foreground="#7582A3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="6" Padding="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#F1F2F6">
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{x:Static core:PhosphorIcons.XCircle}" Fill="#94A3B8"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Excluded, Mode=OneWay, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#131C3D"/>
                                        <TextBlock Text="{core:Tr ams.stats.excluded}" FontSize="10" Opacity="0.85"
                                                   FontWeight="SemiBold" Foreground="#7582A3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ─── RIGHT: realtime + профиль — два отдельных белых блока ─────────────── -->
            <Grid Grid.Column="4"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- ═══ Блок: realtime статистика ═══ -->
                <Border Background="White" BorderBrush="#E4E7EF" BorderThickness="1"
                        CornerRadius="12" Padding="16,16" Margin="0,0,0,12">
                <StackPanel>
                <TextBlock Text="{core:Tr ams.rt.header}" FontSize="10.5"
                           FontWeight="SemiBold" Opacity="0.75"
                           Foreground="#7582A3" Margin="0,0,0,10"/>
                <UniformGrid Columns="2" Rows="2" DataContext="{Binding SelectedMailing}">
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Left">
                                <Path Data="{x:Static core:PhosphorIcons.Eye}" Fill="#3b82f6" Opacity="0.7"/>
                            </Viewbox>
                            <TextBlock Text="{Binding Opened, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#3b82f6" Margin="0,4,0,2"/>
                            <TextBlock Text="{core:Tr ams.rt.opened}" FontSize="9" Opacity="0.85"
                                       FontWeight="SemiBold" Foreground="#7582A3"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Left">
                                <Path Data="{x:Static core:PhosphorIcons.Globe}" Fill="#8b5cf6" Opacity="0.7"/>
                            </Viewbox>
                            <TextBlock Text="{Binding Clicks, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#8b5cf6" Margin="0,4,0,2"/>
                            <TextBlock Text="{core:Tr ams.rt.clicks}" FontSize="9" Opacity="0.85"
                                       FontWeight="SemiBold" Foreground="#7582A3"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Left">
                                <Path Data="{x:Static core:PhosphorIcons.ArrowLeft}" Fill="#ef4444" Opacity="0.7"/>
                            </Viewbox>
                            <TextBlock Text="{Binding UnsubscribeCount, StringFormat={}{0:N0}}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#ef4444" Margin="0,4,0,2"/>
                            <TextBlock Text="{core:Tr ams.rt.unsubscribed}" FontSize="9" Opacity="0.85"
                                       FontWeight="SemiBold" Foreground="#7582A3"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RtTile}">
                        <StackPanel>
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Left">
                                <Path Data="{x:Static core:PhosphorIcons.Broadcast}" Fill="#22c55e" Opacity="0.7"/>
                            </Viewbox>
                            <TextBlock Text="{Binding SpeedText}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#22c55e" Margin="0,4,0,2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{core:Tr ams.rt.speed}" FontSize="9" Opacity="0.85"
                                       FontWeight="SemiBold" Foreground="#7582A3"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                </StackPanel>
                </Border>

                <!-- ═══ Блок: профиль отправки ═══ -->
                <Border Background="White" BorderBrush="#E4E7EF" BorderThickness="1"
                        CornerRadius="12" Padding="16,16">
                <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="{core:Tr ams.profile.header}" FontSize="10.5"
                               FontWeight="SemiBold" Opacity="0.75"
                               Foreground="#7582A3" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding SelectedPresetName}"
                               FontSize="10.5" Foreground="#7582A3"
                               VerticalAlignment="Center" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetThreads}" FontSize="14"
                                       FontWeight="Bold" Foreground="#131C3D"/>
                            <TextBlock Text="{core:Tr ams.profile.threads}" FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                       Foreground="#7582A3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetMethod}" FontSize="12"
                                       FontWeight="Bold" Foreground="#131C3D"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{core:Tr ams.profile.method}" FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                       Foreground="#7582A3"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetMode}" FontSize="12"
                                       FontWeight="Bold" Foreground="#131C3D"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{core:Tr ams.profile.mode}" FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                       Foreground="#7582A3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedPresetProxy}" FontSize="12"
                                       FontWeight="Bold" Foreground="#131C3D"/>
                            <TextBlock Text="{core:Tr ams.profile.proxy}" FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                       Foreground="#7582A3"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{Binding SelectedSenderEmail}" FontSize="11"
                                       FontWeight="Bold" Foreground="#131C3D"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{core:Tr ams.profile.sender}" FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                       Foreground="#7582A3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="{Binding SelectedSenderReply}" FontSize="11"
                                       FontWeight="Bold" Foreground="#131C3D"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{core:Tr ams.profile.replyTo}" FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                       Foreground="#7582A3"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
