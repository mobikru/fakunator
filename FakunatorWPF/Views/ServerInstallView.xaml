<UserControl x:Class="Fakunator.Views.ServerInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fakunator.Converters"
             xmlns:core="clr-namespace:Fakunator.Core"
             Background="{DynamicResource Bg1Brush}">

    <UserControl.Resources>

        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:StringToColorConverter x:Key="StrToColor"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Row в списке серверов (мокап): rounded, hover=серый, Selected=lavender с рамкой. -->
        <Style x:Key="ServerRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Слева без скругления — там садится синий accent-бар выделения,
                 скруглённый угол делал его визуально "срезанным" сверху/снизу. -->
            <Setter Property="CornerRadius" Value="0,10,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f6f7fb"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#eef1fb"/>
                    <Setter Property="BorderBrush" Value="#d5dcf8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Фильтр-пилюля: неактивная серая, активная lavender с синим текстом. -->
        <Style x:Key="FilterPill" TargetType="ToggleButton">
            <Setter Property="Background" Value="#f6f7fb"/>
            <Setter Property="Foreground" Value="#4b5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#eceff5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#eef1fb"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#d5dcf8"/>
                                <Setter Property="Foreground" Value="#4b5bff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#d5dcf8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-звёздочка (favorite): без фона, hover — светлый круг. -->
        <Style x:Key="StarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#eceff5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selectable "TextBlock" — actually TextBox styled to look like plain text.
             Определяем на уровне UserControl чтобы был доступен и в Step 4, и в Overview credentials-блоке. -->
        <Style x:Key="SelText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="SelectionBrush" Value="#3d59a1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CopyBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg4Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="CornerRadius" Value="10,10,0,0"/>
            <Setter Property="BorderBrush" Value="#DFE6F5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#131C3D"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="RowHover" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellDim" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{DynamicResource Fg4Brush}"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <!-- Tab-header button (реф. "Страница проверки" .sc-tabs) -->
        <Style x:Key="TabHead" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#7582A3"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="#F0F3FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="#EDF1FF"/>
                                <Setter TargetName="tab" Property="BorderBrush" Value="#A2B7FF"/>
                                <Setter Property="Foreground" Value="#3261FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}"/>
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- ── 2 columns: table (left) | info+tabs (right) ─────── -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════ COLUMN 1: TABLE ═══════════════════ -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header (icon+title+total+plus) -->
                        <RowDefinition Height="Auto"/>  <!-- search -->
                        <RowDefinition Height="Auto"/>  <!-- filter pills -->
                        <RowDefinition Height="Auto"/>  <!-- column headers -->
                        <RowDefinition Height="*"/>     <!-- rows / empty -->
                        <RowDefinition Height="Auto"/>  <!-- footer (shown + add) -->
                    </Grid.RowDefinitions>

                    <!-- Header ―――――――――――――――――――――――――――――――― -->
                    <Border Grid.Row="0" Padding="16,14,14,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8"
                                    Background="#f2f4f8" Margin="0,0,10,0">
                                <TextBlock Text="🗄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Мои серверы" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Search box ――――――――――――――――――――――――――――― -->
                    <Border Grid.Row="1" Margin="14,4,14,10"
                            Background="#f6f7fb" BorderBrush="#e5e8f0" BorderThickness="1"
                            CornerRadius="10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Fg4Brush}"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                                         Padding="0" FontSize="12.5" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Fg1Brush}"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Домен или IP" FontSize="12.5"
                                           Foreground="{DynamicResource Fg4Brush}"
                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                           Visibility="{Binding HasSearchQuery, Converter={StaticResource InvBool}, ConverterParameter=vis}"/>
                            </Grid>
                            <Button Grid.Column="2" Content="✕" Width="20" Height="20"
                                    FontSize="11" Padding="0" BorderThickness="0"
                                    Background="#e5e8f0" Foreground="{DynamicResource Fg3Brush}"
                                    Cursor="Hand" Click="OnClearSearchClick"
                                    Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Filter pills ―――――――――――――――――――――――――――― -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,0,14,10">
                        <ToggleButton Style="{StaticResource FilterPill}"
                                      IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                      Tag="all" Click="OnFilterClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Все" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CountAll}" Opacity="0.7"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterPill}"
                                      IsChecked="{Binding IsFilterOnline, Mode=OneWay}"
                                      Tag="online" Click="OnFilterClick">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#22c55e" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Онлайн" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CountOnline}" Opacity="0.7"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterPill}"
                                      IsChecked="{Binding IsFilterProblems, Mode=OneWay}"
                                      Tag="problems" Click="OnFilterClick">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#f59e0b" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Проблемы" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CountProblems}" Opacity="0.7"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterPill}"
                                      IsChecked="{Binding IsFilterOffline, Mode=OneWay}"
                                      Tag="offline" Click="OnFilterClick">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#ef4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Офлайн" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CountOffline}" Opacity="0.7"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>


                    <!-- Rows / empty state ―――――――――――――――――――――― -->
                    <Grid Grid.Row="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"
                                    Visibility="{Binding EmptyVisibility}">
                            <TextBlock Text="🛰" FontSize="52" HorizontalAlignment="Center" Foreground="{DynamicResource Fg3Brush}"/>
                            <TextBlock Text="Пока нет серверов"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,10,0,4"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Fg2Brush}"/>
                            <TextBlock Text="Жми «＋ Добавить сервер» ниже"
                                       FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Fg4Brush}"/>
                        </StackPanel>

                        <ScrollViewer Padding="10,0,10,4" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RowsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <!-- Border клипует дочерний контент по своим скруглённым углам (WPF Core) —
                                                 accent-бар должен быть сиблингом, а не потомком, иначе торцы скругляются. -->
                                            <Border Style="{StaticResource ServerRow}"
                                                    MouseLeftButtonUp="OnRowClick">
                                                <Grid Margin="10,10,10,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Fg1Brush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding Ip}" FontSize="11" Foreground="{DynamicResource Fg3Brush}"/>
                                                            <TextBlock Text="   " FontSize="11"/>
                                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                     Fill="{Binding StatusBrush}" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding StatusShort}" FontSize="11"
                                                                       Foreground="{DynamicResource Fg3Brush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding LoadText}" FontSize="12.5"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Fg1Brush}"/>

                                                    <Button Grid.Column="2" Style="{StaticResource StarBtn}"
                                                            Click="OnFavoriteClick" Tag="{Binding}">
                                                        <Grid>
                                                            <TextBlock Text="★" FontSize="18"
                                                                       Foreground="#4b5bff"
                                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="☆" FontSize="18"
                                                                       Foreground="#cbd5e1"
                                                                       Visibility="{Binding IsFavorite, Converter={StaticResource InvBool}, ConverterParameter=vis}"/>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <!-- Left blue accent bar (visible on Selected) — сиблинг Border'а, не потомок. -->
                                            <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                                    Background="#4b5bff"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer ―――――――――――――――――――――――――――――――― -->
                    <Border Grid.Row="5" Padding="16,10,14,14"
                            BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ShownText}"
                                       Foreground="{DynamicResource Fg4Brush}" FontSize="11.5"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Добавить сервер"
                                    Style="{StaticResource ActionBtnGreen}"
                                    core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Plus}"
                                    Click="OnNewInstallClick"/>
                            <TextBlock/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <!-- ═══════════════════ COLUMN 2: INFO PANEL WITH TABS ═══════════════════ -->
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Background="White" DataContext="{Binding Selected}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with server name + actions -->
                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock x:Name="TxtInfoName" Text="{Binding Name, FallbackValue='(выбери сервер)'}"
                                           Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  " FontSize="11.5" Foreground="#7582A3" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetailHeader}"
                                           FontSize="11.5" Foreground="#7582A3" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Обновить" Style="{StaticResource ActionBtnPrimary}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.ArrowClockwise}"
                                        Margin="0,0,6,0" Click="OnRefreshAllClick"/>
                                <Button Content="SSH" Style="{StaticResource ActionBtnNeutral}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.TerminalWindow}"
                                        Margin="0,0,6,0" Click="OnSshClick"/>
                                <Button Content="Удалить" Style="{StaticResource ActionBtnDanger}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Trash}"
                                        Click="OnDeleteServerClick"/>
                            </StackPanel>
                            <TextBlock/>
                        </DockPanel>
                    </Border>

                    <!-- Tabs -->
                    <Border Grid.Row="1" Background="White"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabOverview" GroupName="ServerTabs" Style="{StaticResource TabHead}"
                                         IsChecked="True" Checked="OnServerTabChanged" Content="📊  Обзор"/>
                            <RadioButton x:Name="TabInstall"  GroupName="ServerTabs" Style="{StaticResource TabHead}"
                                         Checked="OnServerTabChanged" Content="🛠  Установка / настройка"/>
                            <RadioButton x:Name="TabLogs"     GroupName="ServerTabs" Style="{StaticResource TabHead}"
                                         Checked="OnServerTabChanged" Content="📜  Логи"/>
                            <RadioButton x:Name="TabDns"      GroupName="ServerTabs" Style="{StaticResource TabHead}"
                                         Checked="OnServerTabChanged" Content="🌐  DNS"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab content -->
                    <Grid Grid.Row="2">

                        <!-- ══ TAB: OVERVIEW ══ -->
                        <ScrollViewer x:Name="TabPaneOverview" Padding="14,12" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- SSH error banner (visible only when unreachable) -->
                                <Border Background="#3f1d1d" BorderBrush="#7f1d1d" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                                        Visibility="{Binding ErrorVisibility, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <TextBlock Text="⚠  SSH-коннект не удался" FontSize="12" FontWeight="SemiBold" Foreground="#fca5a5"/>
                                        <TextBox Text="{Binding ErrorText, Mode=OneWay}" IsReadOnly="True"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 Foreground="#fecaca" FontSize="11" FontFamily="Consolas"
                                                 TextWrapping="Wrap" Margin="0,4,0,0"
                                                 Cursor="IBeam" SelectionBrush="#7f1d1d"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metrics -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- CPU card (blue) -->
                                    <Border Grid.Column="0"
                                            BorderBrush="#3b82f6" BorderThickness="4,0,0,0"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,10,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#1e293b" Direction="270" ShadowDepth="1.5" BlurRadius="10" Opacity="0.14"/>
                                        </Border.Effect>
                                        <Border.Background>
                                            <ImageBrush ImageSource="pack://application:,,,/Assets/CardBg/cpu.png"
                                                        Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                                        </Border.Background>
                                        <StackPanel HorizontalAlignment="Left" MaxWidth="140">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" FontSize="12" Margin="0,0,5,0" Foreground="#3b82f6"/>
                                                <TextBlock Text="CPU LOAD" Foreground="#3b82f6" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LoadText, FallbackValue='—'}" Foreground="{DynamicResource Fg1Brush}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding LoadAvgText, FallbackValue=' '}" Foreground="{DynamicResource Fg4Brush}" FontSize="10.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- RAM card (amber) -->
                                    <Border Grid.Column="1"
                                            BorderBrush="#f59e0b" BorderThickness="4,0,0,0"
                                            CornerRadius="8" Padding="12,10" Margin="5,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#1e293b" Direction="270" ShadowDepth="1.5" BlurRadius="10" Opacity="0.14"/>
                                        </Border.Effect>
                                        <Border.Background>
                                            <ImageBrush ImageSource="pack://application:,,,/Assets/CardBg/ram.png"
                                                        Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                                        </Border.Background>
                                        <StackPanel HorizontalAlignment="Left" MaxWidth="160">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🧠" FontSize="12" Margin="0,0,5,0"/>
