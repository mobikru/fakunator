                                                        </DockPanel>
                                                        <TextBox Text="{Binding Config.Credentials.AmsStatsUrl, Mode=OneWay, FallbackValue='—'}" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent2Brush}"/>
                                                        <TextBox Text="{Binding Config.Credentials.AmsStatsUrlIp, Mode=OneWay, StringFormat='по IP: {0}', FallbackValue='—'}" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource Fg3Brush}" Margin="0,3,0,0"/>
                                                        <TextBox Text="{Binding Config.Credentials.AmsStatsPassword, Mode=OneWay, StringFormat='пароль: {0}', FallbackValue='—'}" Style="{StaticResource SelText}" FontSize="10.5" Foreground="{DynamicResource Fg3Brush}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Log tail placeholder — real tail в отдельной вкладке 📜 Логи -->
                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12"
                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📜  Live tail" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Fg4Brush}"
                                                   Text="Открой вкладку «📜 Логи» сверху — там подключается терминал к /var/log/mail.log, syslog, PMTA-логам и т.п. со стримом в реальном времени."/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ══ TAB: INSTALL / SETUP ══ -->
                        <Grid x:Name="TabPaneInstall" Visibility="Collapsed" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Sub-nav удалена — прогресс-бар ниже уже показывает шаг словом (Настройка/Проверка/…).
                                 TxtWizardStepLabel оставлен hidden — code-behind продолжает его апдейтить (никаких NPE). -->
                            <TextBlock Grid.Row="0" x:Name="TxtWizardStepLabel" Visibility="Collapsed"/>

                            <!-- Progress: 4 круга + 3 сегмента + подписи (Настройка → Проверка → Установка → Готово) -->
                            <Border Grid.Row="1" Margin="0,10,0,0" Padding="24,16,24,14"
                                    Background="White">
                                <StackPanel>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Circle 1 -->
                                        <Border Grid.Column="0" x:Name="StepCircle1" Width="38" Height="38" CornerRadius="19"
                                                Background="#eef0f5" BorderBrush="White" BorderThickness="3">
                                            <Grid>
                                                <TextBlock x:Name="StepNumber1" Text="1" Foreground="#9ca3b6" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StepCheck1" Text="✓" Foreground="White" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <!-- Segment 1 -->
                                        <Border Grid.Column="1" x:Name="StepSeg1" Height="5" VerticalAlignment="Center" CornerRadius="3"
                                                Background="#e7eaf2"/>

                                        <!-- Circle 2 -->
                                        <Border Grid.Column="2" x:Name="StepCircle2" Width="38" Height="38" CornerRadius="19"
                                                Background="#eef0f5" BorderBrush="White" BorderThickness="3">
                                            <Grid>
                                                <TextBlock x:Name="StepNumber2" Text="2" Foreground="#9ca3b6" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StepCheck2" Text="✓" Foreground="White" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <!-- Segment 2 -->
                                        <Border Grid.Column="3" x:Name="StepSeg2" Height="5" VerticalAlignment="Center" CornerRadius="3"
                                                Background="#e7eaf2"/>

                                        <!-- Circle 3 -->
                                        <Border Grid.Column="4" x:Name="StepCircle3" Width="38" Height="38" CornerRadius="19"
                                                Background="#eef0f5" BorderBrush="White" BorderThickness="3">
                                            <Grid>
                                                <TextBlock x:Name="StepNumber3" Text="3" Foreground="#9ca3b6" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StepCheck3" Text="✓" Foreground="White" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <!-- Segment 3 -->
                                        <Border Grid.Column="5" x:Name="StepSeg3" Height="5" VerticalAlignment="Center" CornerRadius="3"
                                                Background="#e7eaf2"/>

                                        <!-- Circle 4 -->
                                        <Border Grid.Column="6" x:Name="StepCircle4" Width="38" Height="38" CornerRadius="19"
                                                Background="#eef0f5" BorderBrush="White" BorderThickness="3">
                                            <Grid>
                                                <TextBlock x:Name="StepNumber4" Text="4" Foreground="#9ca3b6" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StepCheck4" Text="✓" Foreground="White" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Подписи под кругами (те же колонки, текст растянут за границы 38px) -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="StepLabel1" Text="Настройка" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#a1a7b8" HorizontalAlignment="Center" Margin="-40,0,-40,0"/>
                                        <TextBlock Grid.Column="2" x:Name="StepLabel2" Text="Проверка" FontSize="11" FontWeight="Normal"
                                                   Foreground="#a1a7b8" HorizontalAlignment="Center" Margin="-40,0,-40,0"/>
                                        <TextBlock Grid.Column="4" x:Name="StepLabel3" Text="Установка" FontSize="11" FontWeight="Normal"
                                                   Foreground="#a1a7b8" HorizontalAlignment="Center" Margin="-40,0,-40,0"/>
                                        <TextBlock Grid.Column="6" x:Name="StepLabel4" Text="Готово" FontSize="11" FontWeight="Normal"
                                                   Foreground="#a1a7b8" HorizontalAlignment="Center" Margin="-40,0,-40,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Step content -->
                            <Grid Grid.Row="2">

                                <!-- ── Step 1: MERGED — Домен+SSH  ·  Компоненты  ·  Ссылки ── -->
                                <ScrollViewer x:Name="WStep1" Padding="24,20" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>

                                        <!-- ═══ 1. Домен и SSH ═══ -->
                                        <Border CornerRadius="10" Padding="22,18" Margin="0,0,0,16"
                                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush ImageSource="pack://application:,,,/Assets/CardBg/server.png"
                                                            Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                                            </Border.Background>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Border Background="{DynamicResource Accent2Brush}" CornerRadius="10" Width="20" Height="20" Margin="0,0,10,0">
                                                        <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Сервер и домен"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  ·  куда ставим"
                                                               FontSize="11.5" Foreground="{DynamicResource Fg4Brush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="Домен" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="TxtDomain" Style="{StaticResource FieldInput}" Text="mydomain.xyz" FontSize="12.5" Padding="11,8" Margin="0,0,0,12" Width="280"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="IP сервера" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="TxtServerIp" Style="{StaticResource FieldInput}" Text="185.44.22.9" FontSize="12.5" Padding="11,8" Margin="0,0,0,12" Width="280"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="SSH пользователь" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="TxtSshUser" Style="{StaticResource FieldInput}" Text="root" FontSize="12.5" Padding="11,8" Margin="0,0,0,12" Width="280"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Порт" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="TxtSshPort" Style="{StaticResource FieldInput}" Text="22" FontSize="12.5" Padding="11,8" Margin="0,0,0,12" Width="90"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="SSH пароль" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <PasswordBox x:Name="PwdSsh" Background="{DynamicResource Bg2Brush}"
                                                                     Foreground="{DynamicResource Fg1Brush}"
                                                                     BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                                                                     Padding="11,8" FontSize="12.5" Margin="0,0,0,4" Width="280"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Email для Let's Encrypt" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="TxtLeEmail" Style="{StaticResource FieldInput}" Text="info@mydomain.xyz" FontSize="12.5" Padding="11,8" Margin="0,0,0,4" Width="280"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- ═══ 2. Компоненты ═══ -->
                                        <Border CornerRadius="10" Padding="22,18" Margin="0,0,0,16"
                                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush ImageSource="pack://application:,,,/Assets/CardBg/components.png"
                                                            Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                                            </Border.Background>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Border Background="{DynamicResource Accent2Brush}" CornerRadius="10" Width="20" Height="20" Margin="0,0,10,0">
                                                        <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Компоненты"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  ·  что установить (базовые обязательны)"
                                                               FontSize="11.5" Foreground="{DynamicResource Fg4Brush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <StackPanel Width="170" Margin="0,0,16,0">
                                                        <TextBlock Text="БАЗОВЫЕ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}" Margin="0,0,0,8"/>
                                                        <CheckBox IsChecked="True" IsEnabled="False" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Postfix" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" IsEnabled="False" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Dovecot" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" IsEnabled="False" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="MariaDB" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" IsEnabled="False" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="OpenDKIM" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" IsEnabled="False" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Bind9" FontSize="12.5"/></CheckBox>
                                                    </StackPanel>

                                                    <StackPanel Width="170" Margin="0,0,16,0">
                                                        <TextBlock Text="ВЕБ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}" Margin="0,0,0,8"/>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Apache + PHP" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Certbot (SSL)" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Roundcube" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="phpMyAdmin" FontSize="12.5"/></CheckBox>
                                                    </StackPanel>

                                                    <StackPanel Width="170">
                                                        <TextBlock Text="ДОПОЛНИТЕЛЬНО" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg4Brush}" Margin="0,0,0,8"/>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="PMTA (BYO)" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="zTDS (BYO)" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Mailer-скрипты" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="3proxy" FontSize="12.5"/></CheckBox>
                                                        <CheckBox IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"><TextBlock Text="Landing" FontSize="12.5"/></CheckBox>
                                                        <CheckBox x:Name="ChkAmsStats" IsChecked="True" Foreground="{DynamicResource Fg2Brush}" Margin="0,4"
                                                                  ToolTip="Заливает amsweb.php + .htaccess в /ams на домене — трекинг открытий/кликов/отписок для AMS Enterprise">
                                                            <TextBlock Text="AMS RealTime статистика" FontSize="12.5"/>
                                                        </CheckBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- ═══ 3. Ссылки на пакеты ═══ -->
                                        <Border Background="{DynamicResource Bg3Brush}" CornerRadius="10" Padding="22,18" Margin="0,0,0,8"
                                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Border Background="{DynamicResource Accent2Brush}" CornerRadius="10" Width="20" Height="20" Margin="0,0,10,0">
                                                        <TextBlock Text="3" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Ссылки на пакеты"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  ·  «%default_url%» = встроенная сборка, вставь свою ссылку чтобы скачать из другого источника"
                                                               FontSize="11.5" Foreground="{DynamicResource Fg4Brush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PMTA .deb" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="UrlPmtaDeb" Text="%default_url%" GotFocus="OnUrlFieldGotFocus" Foreground="{DynamicResource Fg4Brush}" Style="{StaticResource FieldInput}" FontSize="11.5" Padding="10,7" Margin="0,0,0,10"/>
                                                        <TextBlock Text="PMTA pmtad" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="UrlPmtad" Text="%default_url%" GotFocus="OnUrlFieldGotFocus" Foreground="{DynamicResource Fg4Brush}" Style="{StaticResource FieldInput}" FontSize="11.5" Padding="10,7" Margin="0,0,0,10"/>
                                                        <TextBlock Text="PMTA pmtahttpd" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="UrlPmtaHttpd" Text="%default_url%" GotFocus="OnUrlFieldGotFocus" Foreground="{DynamicResource Fg4Brush}" Style="{StaticResource FieldInput}" FontSize="11.5" Padding="10,7" Margin="0,0,0,10"/>
                                                        <TextBlock Text="PMTA license" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="UrlPmtaLicense" Text="%default_url%" GotFocus="OnUrlFieldGotFocus" Foreground="{DynamicResource Fg4Brush}" Style="{StaticResource FieldInput}" FontSize="11.5" Padding="10,7" Margin="0,0,0,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="zTDS.zip" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="UrlZtds" Text="%default_url%" GotFocus="OnUrlFieldGotFocus" Foreground="{DynamicResource Fg4Brush}" Style="{StaticResource FieldInput}" FontSize="11.5" Padding="10,7" Margin="0,0,0,10"/>
                                                        <TextBlock Text="Mailer (phpmailer.zip)" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="UrlMailer" Text="%default_url%" GotFocus="OnUrlFieldGotFocus" Foreground="{DynamicResource Fg4Brush}" Style="{StaticResource FieldInput}" FontSize="11.5" Padding="10,7" Margin="0,0,0,10"/>
                                                        <TextBlock Text="Landing" Style="{StaticResource FieldLabel}" FontSize="12"/>
                                                        <TextBox x:Name="UrlLanding" Text="%default_url%" GotFocus="OnUrlFieldGotFocus" Foreground="{DynamicResource Fg4Brush}" Style="{StaticResource FieldInput}" FontSize="11.5" Padding="10,7" Margin="0,0,0,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ── Step 2: Verify (REAL preflight checks, реф. "Страница проверки") ── -->
                                <ScrollViewer x:Name="WStep2" Background="White" Padding="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- Hero: иллюстрация крупная и позади текста (может уходить под соседние блоки — это ок) -->
                                        <Grid Margin="28,20,28,4" MinHeight="90">
                                            <Image Source="/Assets/ServerInstall/server-check.png" Stretch="Uniform" Panel.ZIndex="0"
                                                   MaxHeight="280" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,-34,-10,-70" IsHitTestVisible="False"/>

                                            <StackPanel Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="620">
                                                <TextBlock Text="Проверка перед установкой" FontSize="33" FontWeight="Bold" Foreground="#131C3D"
                                                           TextWrapping="Wrap" Margin="0,0,0,7"/>
                                                <TextBlock Text="Проверяем подключение, ресурсы и готовность сервера." FontSize="17" Foreground="#7582A3" TextWrapping="Wrap" Margin="0,0,0,22"/>

                                                <StackPanel x:Name="PreflightSummaryRunning" Orientation="Horizontal" Visibility="Collapsed">
                                                    <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                                        <Path Data="{x:Static core:PhosphorIcons.SpinnerGap}" Fill="#3261FF"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Выполняется проверка сервера…" FontSize="17" Foreground="#414C80"/>
                                                </StackPanel>
                                                <WrapPanel x:Name="PreflightSummaryCounts" Orientation="Horizontal">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                                        <Viewbox Width="21" Height="21" Margin="0,0,8,0">
                                                            <Path Data="{x:Static core:PhosphorIcons.CheckCircle}" Fill="#0AAD70"/>
                                                        </Viewbox>
                                                        <TextBlock FontSize="14.5" Foreground="#414C80" VerticalAlignment="Center">
                                                            <Run x:Name="TxtPreflightOk" Text="0" FontWeight="Bold" Foreground="#131C3D"/>
                                                            <Run Text=" проверок пройдено"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Width="1" Background="#B6C3ED" Margin="0,2,18,8"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                                        <Viewbox Width="21" Height="21" Margin="0,0,8,0">
                                                            <Path Data="{x:Static core:PhosphorIcons.Warning}" Fill="#E27B00"/>
                                                        </Viewbox>
                                                        <TextBlock FontSize="14.5" Foreground="#414C80" VerticalAlignment="Center">
                                                            <Run x:Name="TxtPreflightWarn" Text="0" FontWeight="Bold" Foreground="#131C3D"/>
                                                            <Run Text=" предупреждения"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Width="1" Background="#B6C3ED" Margin="0,2,18,8"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Viewbox Width="21" Height="21" Margin="0,0,8,0">
                                                            <Path Data="{x:Static core:PhosphorIcons.XCircle}" Fill="#EC224D"/>
                                                        </Viewbox>
                                                        <TextBlock FontSize="14.5" Foreground="#414C80" VerticalAlignment="Center">
                                                            <Run x:Name="TxtPreflightFail" Text="0" FontWeight="Bold" Foreground="#131C3D"/>
                                                            <Run x:Name="TxtPreflightFailLabel" Text=" ошибок"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Table -->
                                        <Border Margin="28,14,28,24" BorderBrush="#DFE6F5" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                            <StackPanel>
                                                <Grid Background="#F7FAFF">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30*"/>
                                                        <ColumnDefinition Width="52*"/>
                                                        <ColumnDefinition Width="18*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="ПРОВЕРКА" FontSize="10.5" FontWeight="Bold" Foreground="#4D5B90" Padding="20,9"/>
                                                    <TextBlock Grid.Column="1" Text="РЕЗУЛЬТАТ" FontSize="10.5" FontWeight="Bold" Foreground="#4D5B90" Padding="20,9"/>
                                                    <TextBlock Grid.Column="2" Text="СТАТУС" FontSize="10.5" FontWeight="Bold" Foreground="#4D5B90" Padding="20,9"/>
                                                </Grid>
                                                <ItemsControl x:Name="PreflightList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#DFE6F5" BorderThickness="0,1,0,0" Padding="20,9">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30*"/>
                                                                        <ColumnDefinition Width="52*"/>
                                                                        <ColumnDefinition Width="18*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,10,0">
                                                                        <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                                                                            <Path Data="{Binding RowIcon}" Fill="#4D5B90"/>
                                                                        </Viewbox>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="#131C3D" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                        <WrapPanel>
                                                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#45507D"/>
                                                                            <Button Click="OnTogglePackagesClick"
                                                                                    Visibility="{Binding HasPackages, Converter={StaticResource BoolVis}}"
                                                                                    Padding="0" Margin="9,0,0,0"
                                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding ToggleLabel}" Foreground="#3261FF" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                                    <Viewbox Width="9" Height="9">
                                                                                        <Path Data="{x:Static core:PhosphorIcons.CaretDown}" Fill="#3261FF"/>
                                                                                    </Viewbox>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </WrapPanel>
                                                                        <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="#7582A3" TextWrapping="Wrap"
                                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" Margin="0,2,0,0"/>
                                                                        <ItemsControl ItemsSource="{Binding Packages}"
                                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}"
                                                                                      Margin="0,5,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock FontSize="11.5" Foreground="#7582A3" Margin="0,0,0,3">
                                                                                        <Run Text="{Binding Name}"/><Run Text=" — "/><Run Text="{Binding Result}"/>
                                                                                    </TextBlock>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                                        <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                                                            <Path Data="{Binding StatusIcon}" Fill="{Binding StatusBrush}"/>
                                                                        </Viewbox>
                                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ── Step 3: Installing (LIVE LOG) ── -->
                                <Grid x:Name="WStep3" Visibility="Collapsed" Background="White" Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>    <!-- workspace -->
                                        <RowDefinition Height="Auto"/> <!-- footer -->
                                        <RowDefinition Height="Auto"/> <!-- collapsible journal -->
                                    </Grid.RowDefinitions>

                                            <!-- Workspace: иллюстрация | панель прогресса -->
                                            <Grid Grid.Row="0" Margin="24,4,24,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.92*"/>
                                                    <ColumnDefinition Width="1.08*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Visual: парящая иллюстрация + частицы -->
                                                <Border Grid.Column="0" Margin="0,0,20,0" Background="White" CornerRadius="12" ClipToBounds="True">
                                                <Grid x:Name="ServerVisualGrid">
                                                    <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>
                                                    <Image x:Name="ServerArtImage" Source="/Assets/ServerInstall/server-assembly.png"
                                                           Stretch="Uniform" MaxHeight="440" RenderTransformOrigin="0.5,0.5">
                                                        <Image.RenderTransform>
                                                            <TranslateTransform x:Name="ServerArtFloatTransform" Y="0"/>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                    <TextBlock Text="Веб-интерфейс" FontWeight="SemiBold" FontSize="12.5" Foreground="#131C3D"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,44,0,0"/>
                                                    <TextBlock Text="Roundcube, phpMyAdmin" FontSize="10.5" Foreground="#7582A3" TextWrapping="Wrap" MaxWidth="140"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,64,0,0"/>
                                                    <TextBlock Text="Почта" FontWeight="SemiBold" FontSize="12.5" Foreground="#131C3D"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,166,0,0"/>
                                                    <TextBlock Text="Postfix, Dovecot, OpenDKIM" FontSize="10.5" Foreground="#7582A3" TextWrapping="Wrap" MaxWidth="140"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,186,0,0"/>
                                                    <TextBlock Text="База данных" FontWeight="SemiBold" FontSize="12.5" Foreground="#131C3D"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,282,0,0"/>
                                                    <TextBlock Text="MariaDB" FontSize="10.5" Foreground="#7582A3"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,302,0,0"/>
                                                </Grid>
                                                </Border>

                                                <!-- Panel: прогресс / текущий шаг / список компонентов -->
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock x:Name="TxtPackagesDone" DockPanel.Dock="Right" Text="0 из 0 компонентов"
                                                                   FontSize="12" Foreground="#7582A3" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                                                        <TextBlock x:Name="TxtInstTitle" Text="Собираем ваш сервер" FontSize="25"
                                                                   FontWeight="Bold" Foreground="#131C3D"/>
                                                    </DockPanel>
                                                    <TextBlock x:Name="TxtInstSubtitle"
                                                               Text="Устанавливаем и настраиваем необходимые компоненты. Это может занять несколько минут."
                                                               FontSize="13" Foreground="#7582A3" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                                    <!-- Прогресс -->
                                                    <DockPanel Margin="0,0,0,12">
                                                        <TextBlock DockPanel.Dock="Left" x:Name="TxtInstallProgressLbl" Text="0%"
                                                                   FontSize="36" FontWeight="Bold" Foreground="#4E68FF"
                                                                   Margin="0,0,16,0" VerticalAlignment="Center"/>
                                                        <Grid Height="9" VerticalAlignment="Center">
                                                            <Border CornerRadius="5" Background="#ECF0FA"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition x:Name="ProgressFillCol" Width="0*"/>
                                                                    <ColumnDefinition x:Name="ProgressRestCol" Width="100*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="ProgressFillBorder" Grid.Column="0" CornerRadius="5" Background="#4E68FF"/>
                                                            </Grid>
                                                        </Grid>
                                                    </DockPanel>

                                                    <!-- Красная плашка ошибки — видна только при failure -->
                                                    <Border x:Name="InstallErrorBanner" Visibility="Collapsed"
                                                            Background="#FFF4F5" BorderBrush="#F0CCD2" BorderThickness="1"
                                                            CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                                        <TextBox x:Name="TxtInstallErrorMsg" Text="" IsReadOnly="True"
                                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                                 Foreground="#B43B4B" FontSize="11.5"
                                                                 TextWrapping="Wrap" Cursor="IBeam" SelectionBrush="#F0CCD2"/>
                                                    </Border>

                                                    <!-- Текущий компонент + время -->
                                                    <Grid Margin="0,0,0,13">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock x:Name="TxtCurrentLabel" Text="Текущий компонент" FontSize="11.5" Foreground="#7582A3"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock x:Name="TxtCurrentIcon" Text="⚙" FontSize="15" Foreground="#4E68FF" Margin="0,0,8,0"/>
                                                                <TextBlock x:Name="TxtCurrentName" Text="Подготовка" FontSize="16" FontWeight="SemiBold" Foreground="#131C3D"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="TxtCurrentDesc" Text="Ожидание запуска установки"
                                                                       FontSize="11.5" Foreground="#7582A3" Margin="23,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#F7F8FC" CornerRadius="8" Padding="12,7">
                                                            <StackPanel Orientation="Horizontal">
                                                                <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                                                    <TextBlock Text="⏳" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Прошло" FontSize="10.5" Foreground="#7582A3"/>
                                                                        <TextBlock x:Name="TxtElapsed" Text="00:00" FontSize="12.5" FontWeight="SemiBold" Foreground="#131C3D"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="🕐" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Осталось" FontSize="10.5" Foreground="#7582A3"/>
                                                                        <TextBlock x:Name="TxtRemaining" Text="Уточняется" FontSize="12.5" FontWeight="SemiBold" Foreground="#131C3D"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                                        <ItemsControl x:Name="PhaseChips" Margin="0,0,0,6">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding RowBackground}" CornerRadius="6" Padding="6,6" Margin="0,0,0,2">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="22"/>
                                                                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto" MinWidth="40"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}"
                                                                                       Foreground="{Binding RowIconBrush}" FontSize="13" FontWeight="Bold"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                                       Foreground="{Binding RowNameBrush}" FontSize="13"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}"
                                                                                       Foreground="{Binding RowStatusBrush}" FontSize="11.5"
                                                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                                                       Foreground="#9CA3B6" FontSize="11" FontFamily="Consolas"
                                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Footer -->
                                            <Border Grid.Row="1" BorderBrush="#E9EDF5" BorderThickness="0,1,0,0"
                                                    Background="#FCFDFF" Padding="22,11">
                                                <DockPanel>
                                                    <TextBlock x:Name="TxtFootStatus" DockPanel.Dock="Left"
                                                               Text="Не закрывайте окно до завершения" FontSize="11.5"
                                                               Foreground="#7582A3" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="BtnToggleLog" Content="Показать журнал"
                                                                Style="{StaticResource ActionBtnNeutral}"
                                                                core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Desktop}"
                                                                Click="OnToggleLogClick"/>
                                                        <Button x:Name="BtnCancelInstall" Content="Отменить установку"
                                                                Style="{StaticResource ActionBtnDanger}"
                                                                core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.XCircle}"
                                                                Margin="8,0,0,0" Click="OnCancelInstallClick"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- Свернутый по умолчанию журнал (терминал) -->
                                            <Border x:Name="LogPanelBorder" Grid.Row="2" Visibility="Collapsed"
                                                    Background="#0a0e14" CornerRadius="10" Margin="24,10,24,14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="#151b23" Padding="12,7"
                                                            BorderBrush="#1e2530" BorderThickness="0,0,0,1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="9" Height="9" Fill="#ff5f56" Margin="0,0,5,0"/>
                                                            <Ellipse Width="9" Height="9" Fill="#ffbd2e" Margin="0,0,5,0"/>
                                                            <Ellipse Width="9" Height="9" Fill="#27c93f" Margin="0,0,10,0"/>
                                                            <TextBlock x:Name="TxtLogHeader" Text="root@ — live install log"
                                                                       Foreground="#8b95a3" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <RichTextBox x:Name="InstallLogRtb" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                                                                 Background="Transparent" Foreground="#c0caf5"
                                                                 BorderThickness="0" Padding="12,9" Height="220"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 HorizontalScrollBarVisibility="Auto"
                                                                 SelectionBrush="#3d59a1"
                                                                 FontFamily="Consolas" FontSize="11">
                                                        <FlowDocument PageWidth="2000">
                                                            <Paragraph LineHeight="15" Margin="0"/>
                                                        </FlowDocument>
                                                    </RichTextBox>
                                                </Grid>
                                            </Border>

                                    <!-- Скрытые служебные элементы: code-behind продолжает их апдейтить -->
                                    <TextBlock x:Name="TxtInstallHeader" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TxtWizardCurrent" Visibility="Collapsed"/>
                                    <Button x:Name="BtnCopyInstallLog" Visibility="Collapsed" Click="OnCopyInstallLogClick"/>
                                    <ProgressBar x:Name="InstallProgressBar" Visibility="Collapsed" Value="0" Maximum="100"/>
                                </Grid>

                                <!-- ── Step 4: Done ── -->
                                <ScrollViewer x:Name="WStep4" Padding="24,20" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="🎉" FontSize="26" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="TxtDoneTitle" Text="Готово" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDoneSubtitle" Text="Установка завершена" FontSize="11.5" Margin="0,0,0,16" Foreground="{DynamicResource Fg4Brush}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <!-- PMTA Monitor -->
                                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Text="🖥  PMTA Monitor" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                            <Button x:Name="BtnCopyPmta" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать"
                                                                    Click="OnCopyClick" Tag="—"/>
                                                            <TextBlock/>
                                                        </DockPanel>
                                                        <TextBox x:Name="TxtPmtaUrl" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                                                        <TextBox x:Name="TxtPmtaCreds" Style="{StaticResource SelText}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                        <TextBox x:Name="TxtPmtaSmtp" Style="{StaticResource SelText}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Webmail -->
                                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Text="✉  Webmail" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                            <Button x:Name="BtnCopyWebmail" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать"
                                                                    Click="OnCopyClick" Tag="—"/>
                                                            <TextBlock/>
                                                        </DockPanel>
                                                        <TextBox x:Name="TxtWebmailUrl" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                                                        <TextBox x:Name="TxtWebmailCreds" Style="{StaticResource SelText}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- phpMyAdmin -->
                                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Text="🗄  phpMyAdmin" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                            <Button x:Name="BtnCopyPma" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать"
                                                                    Click="OnCopyClick" Tag="—"/>
                                                            <TextBlock/>
                                                        </DockPanel>
                                                        <TextBox x:Name="TxtPmaUrl" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                                                        <TextBox x:Name="TxtPmaCreds" Style="{StaticResource SelText}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <!-- zTDS Admin -->
                                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Text="🔀  zTDS Admin" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                            <Button x:Name="BtnCopyTds" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать"
                                                                    Click="OnCopyClick" Tag="—"/>
                                                            <TextBlock/>
                                                        </DockPanel>
                                                        <TextBox x:Name="TxtTdsUrl" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                                                        <TextBox x:Name="TxtTdsCreds" Style="{StaticResource SelText}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- 3proxy -->
                                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Text="🔀  3proxy (SOCKS5)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                            <Button x:Name="BtnCopy3proxy" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать"
                                                                    Click="OnCopyClick" Tag="—"/>
                                                            <TextBlock/>
                                                        </DockPanel>
                                                        <TextBox x:Name="Txt3proxyUrl" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                                                        <TextBox x:Name="Txt3proxyCreds" Style="{StaticResource SelText}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Landing -->
                                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Text="🌐  Лендинг" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                            <Button x:Name="BtnCopyLanding" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать"
                                                                    Click="OnCopyClick" Tag="—"/>
                                                            <TextBlock/>
                                                        </DockPanel>
                                                        <TextBox x:Name="TxtLandingUrl" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- AMS RealTime статистика -->
                                                <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Text="📈  AMS RealTime статистика" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                            <Button x:Name="BtnCopyAmsStats" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать"
                                                                    Click="OnCopyClick" Tag="—"/>
                                                            <TextBlock/>
                                                        </DockPanel>
                                                        <TextBox x:Name="TxtAmsStatsUrl" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Accent2Brush}" Text="—"/>
                                                        <TextBox x:Name="TxtAmsStatsUrlIp" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                        <TextBox x:Name="TxtAmsStatsCreds" Style="{StaticResource SelText}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" Text="—" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- DNS records (large, selectable, with copy) -->
                                        <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,6,0,0"
                                                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Left" Text="📋  DNS-записи для регистратора" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                    <Button x:Name="BtnCopyDns" DockPanel.Dock="Right" Style="{StaticResource CopyBtn}" Content="📋 копировать все"
                                                            Click="OnCopyDnsClick"/>
                                                    <TextBlock/>
                                                </DockPanel>
                                                <TextBox x:Name="TxtDnsRecords" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                         Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                                                         Padding="12,10" MinHeight="140"
                                                         Cursor="IBeam" SelectionBrush="#3d59a1"
                                                         FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Fg2Brush}"
                                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         Text="A     @                    185.44.22.9&#x0A;A     mail                 185.44.22.9&#x0A;MX    @                    mail.mydomain.xyz (priority 10)&#x0A;TXT   @                    v=spf1 ip4:185.44.22.9 ~all&#x0A;TXT   default._domainkey   v=DKIM1; k=rsa; p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDUdxPJ8Kx9nQvGmR2sT7bYwZa3vH8yFcJ4qKlNmPzE5jRxVwOeI6hDgSFtLuBnCkMoI9pYhWqXjAsBrEcTiPvUyKlNhFgDrCwZ2sMx8nTqBpVyJc6WaK7HuLpEfRj5N3oDbGmTxYzC4kAvSlQwIDAQAB&#x0A;TXT   _dmarc               v=DMARC1; p=quarantine; rua=mailto:info@mydomain.xyz; ruf=mailto:info@mydomain.xyz; adkim=r; aspf=r; pct=100"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                            </Grid>

                            <!-- Wizard footer nav -->
                            <Border Grid.Row="3" Background="{DynamicResource Bg1Brush}"
                                    BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,1,0,0"
                                    Padding="14,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" x:Name="BtnWizBack"
                                            Content="Назад" Style="{StaticResource ActionBtnNeutral}"
                                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.ArrowLeft}"
                                            IsEnabled="False" Click="OnWizardBackClick"/>
                                    <Button DockPanel.Dock="Right" x:Name="BtnWizNext"
                                            Content="Далее" Style="{StaticResource ActionBtnNeutral}"
                                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.ArrowRight}"
                                            Click="OnWizardNextClick"/>
                                    <Button DockPanel.Dock="Right" x:Name="BtnRerunPreflight"
                                            Style="{DynamicResource AccentBtn}" Visibility="Collapsed"
                                            Padding="14,6" FontSize="11.5" Margin="0,0,8,0" Cursor="Hand"
                                            Click="OnRerunPreflightClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                                <Path Data="{x:Static core:PhosphorIcons.ArrowClockwise}" Fill="{DynamicResource Accent2Brush}"/>
                                            </Viewbox>
                                            <TextBlock Text="Повторить проверку" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Right" x:Name="BtnWizSaveOnly"
                                            Content="Только сохранить"
                                            Style="{StaticResource ActionBtnNeutral}"
                                            core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.FloppyDisk}"
                                            Margin="0,0,8,0"
                                            ToolTip="Сохранить в реестр и мониторить существующий сервер, без установки пакетов"
                                            Click="OnSaveOnlyClick"/>
                                    <TextBlock/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ══ TAB: LOGS ══ -->
                        <Grid x:Name="TabPaneLogs" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource Bg2Brush}" Padding="14,10"
                                    BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <TextBlock Text="📜  Live tail  ·" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbLogSource" Width="220" Margin="10,0,0,0" FontSize="11.5">
                                            <ComboBoxItem Content="/var/log/mail.log (postfix + dovecot)" IsSelected="True" Tag="/var/log/mail.log"/>
                                            <ComboBoxItem Content="/var/log/syslog" Tag="/var/log/syslog"/>
                                            <ComboBoxItem Content="/var/log/apache2/access.log" Tag="/var/log/apache2/access.log"/>
                                            <ComboBoxItem Content="/var/log/apache2/error.log" Tag="/var/log/apache2/error.log"/>
                                            <ComboBoxItem Content="/var/log/pmta/log" Tag="/var/log/pmta/log"/>
                                            <ComboBoxItem Content="/var/log/auth.log" Tag="/var/log/auth.log"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <CheckBox x:Name="ChkAutoScroll" Content="Автопрокрутка" IsChecked="True" Foreground="{DynamicResource Fg3Brush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnClearLog" Content="Очистить"
                                                Style="{StaticResource ActionBtnNeutral}"
                                                core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.XCircle}"
                                                Margin="0,0,6,0" Click="OnClearTailClick"/>
                                        <Button x:Name="BtnTailToggle" Content="Запустить"
                                                Style="{StaticResource ActionBtnGreen}"
                                                core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.Play}"
                                                Click="OnTailToggleClick"/>
                                    </StackPanel>
                                    <TextBlock/>
                                </DockPanel>
                            </Border>

                            <!-- Terminal-style log -->
                            <Border Grid.Row="1" Background="#0a0e14" Margin="12" CornerRadius="8" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#151b23" CornerRadius="8,8,0,0" Padding="12,7"
                                            BorderBrush="#1e2530" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="#ff5f56" Margin="0,0,5,0"/>
                                            <Ellipse Width="9" Height="9" Fill="#ffbd2e" Margin="0,0,5,0"/>
                                            <Ellipse Width="9" Height="9" Fill="#27c93f" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="TxtTailHeader" Text="not connected" Foreground="#8b95a3" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <RichTextBox x:Name="TailRtb" Grid.Row="1" IsReadOnly="True"
                                                 Background="Transparent" Foreground="#c0caf5"
                                                 BorderThickness="0" Padding="12,9"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 SelectionBrush="#3d59a1"
                                                 FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ══ TAB: DNS ══ -->
                        <Grid x:Name="TabPaneDns" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовок + кнопка обновить -->
                            <DockPanel Grid.Row="0" Margin="14,12,14,8">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="🌐  DNS &amp; Trust checker" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="Проверка обязательных DNS-записей, репутации IP и рекомендации по trust'у"
                                               FontSize="11" Foreground="{DynamicResource Fg4Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" x:Name="BtnRefreshDns" Style="{StaticResource ActionBtnGreen}"
                                        core:IconButtonHelper.Icon="{x:Static core:PhosphorIcons.ArrowClockwise}"
                                        Content="{Binding BusyText, FallbackValue='Проверить всё'}"
                                        IsEnabled="{Binding IsChecking, Converter={StaticResource InvBool}}"
                                        Click="OnRefreshDnsClick"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinWidth="140"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" Padding="14,4,14,14" VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- Section 1: Обязательные DNS-записи -->
                                    <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                                            BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📌  Обязательные DNS-записи" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding Required}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="5" Padding="10,8" Margin="0,0,0,4"
                                                                BorderThickness="3,0,0,0">
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="{Binding Color, Converter={StaticResource StrToColor}, FallbackValue='#6b7280'}"/>
                                                            </Border.BorderBrush>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="170"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center">
                                                                    <TextBlock.Foreground>
                                                                        <SolidColorBrush Color="{Binding Color, Converter={StaticResource StrToColor}}"/>
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource Fg2Brush}"/>
                                                                    <TextBlock Text="{Binding Expected}" FontSize="10" Foreground="{DynamicResource Fg4Brush}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBox Text="{Binding Actual, Mode=OneWay}" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Fg1Brush}"/>
                                                                    <TextBlock Text="{Binding Hint}" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap">
                                                                        <TextBlock.Foreground>
                                                                            <SolidColorBrush Color="{Binding Color, Converter={StaticResource StrToColor}}"/>
                                                                        </TextBlock.Foreground>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 2: IP репутация (blacklists) -->
                                    <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                                            BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🛡  IP-репутация (DNSBL)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding Blacklist}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="5" Padding="10,8" Margin="0,0,0,4"
                                                                BorderThickness="3,0,0,0">
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="{Binding Color, Converter={StaticResource StrToColor}}"/>
                                                            </Border.BorderBrush>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="170"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center">
                                                                    <TextBlock.Foreground>
                                                                        <SolidColorBrush Color="{Binding Color, Converter={StaticResource StrToColor}}"/>
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg2Brush}"/>
                                                                    <TextBlock Text="{Binding Expected}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource Fg4Brush}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBox Text="{Binding Actual, Mode=OneWay}" Style="{StaticResource SelText}" FontFamily="Consolas" FontSize="11">
                                                                        <TextBox.Foreground>
                                                                            <SolidColorBrush Color="{Binding Color, Converter={StaticResource StrToColor}}"/>
                                                                        </TextBox.Foreground>
                                                                    </TextBox>
                                                                    <TextBlock Text="{Binding Hint}" FontSize="10.5" Margin="0,2,0,0" Foreground="{DynamicResource Fg4Brush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 3: Trust boosters -->
                                    <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="14,12"
                                            BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🔒  Trust boosters (рекомендации)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg1Brush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="MUST — без этого письма в спам гарантированно. BOOST — сильно поднимут репутацию у Gmail/Mail.ru/Yahoo."
                                                       FontSize="10.5" Foreground="{DynamicResource Fg4Brush}" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding Boosters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="5" Padding="10,8" Margin="0,0,0,4">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <Border CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding BadgeColor, Converter={StaticResource StrToColor}}"/>
                                                                        </Border.Background>
                                                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Body}" FontSize="10.5" Foreground="{DynamicResource Fg3Brush}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
