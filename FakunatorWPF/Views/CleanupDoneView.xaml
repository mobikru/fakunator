<UserControl x:Class="Fakunator.Views.CleanupDoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" x:Name="RootPanel">

            <!-- ── Hero card ──────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <!-- Green left accent stripe -->
                    <Border Width="4" HorizontalAlignment="Left"
                            Background="{DynamicResource CleanBrush}"
                            CornerRadius="12,0,0,12"/>

                    <DockPanel Margin="20,16">
                        <!-- Green checkmark circle -->
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource CleanBrush}"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="&#x2713;" Foreground="White"
                                       FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Right-side stat boxes -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <!-- ВРЕМЯ -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ВРЕМЯ" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroElapsed" Text="00:00" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- СКОРОСТЬ -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="СКОРОСТЬ" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroSpeed" Text="0/с" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ПРОЧИТАНО -->
                            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ПРОЧИТАНО" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroFileSize" Text="0 B" FontSize="14"
                                               FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Title & subtitle -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Готово · база очищена" FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg1Brush}"/>
                            <TextBlock x:Name="TxtSubtitle" FontSize="13"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       Margin="0,4,0,0"
                                       Text="Из 0 строк получено 0 чистых адресов (0%)"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ── Provider donut + top result cards row ─────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Provider donut card -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Width="340" Padding="16,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="ПО ДОМЕНАМ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="из Clean"
                                       FontSize="10" Foreground="{DynamicResource Fg4Brush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel x:Name="DonutLegend" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Валидные (clean) card — BIG green -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Border Height="3" VerticalAlignment="Top" CornerRadius="12,12,0,0"
                                Background="{DynamicResource CleanBrush}"/>
                        <StackPanel Margin="14,14,14,12">
                            <TextBlock Text="● Валидные" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource CleanBrush}"/>
                            <TextBlock x:Name="CleanCount" Text="0" FontSize="28"
                                       FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Fg1Brush}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="CleanPct" Text="0%" FontSize="12"
                                       Foreground="{DynamicResource Fg3Brush}"/>
                            <Button x:Name="BtnCleanFile" Content="↓ clean.txt" FontSize="11"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource Accent2Brush}"
                                    Padding="0,6,0,0" HorizontalAlignment="Left"
                                    Click="OnCleanFileClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Дубликаты card — BIG yellow -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Border Height="3" VerticalAlignment="Top" CornerRadius="12,12,0,0"
                                Background="#eab308"/>
                        <StackPanel Margin="14,14,14,12">
                            <TextBlock Text="● Дубликаты" FontWeight="Bold" FontSize="13"
                                       Foreground="#eab308"/>
                            <TextBlock x:Name="DupCount" Text="0" FontSize="28"
                                       FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Fg1Brush}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="DupPct" Text="0%" FontSize="12"
                                       Foreground="{DynamicResource Fg3Brush}"/>
                            <Button Content="↓ rejected_duplicate.txt" FontSize="11"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource Accent2Brush}"
                                    Padding="0,6,0,0" HorizontalAlignment="Left"
                                    Tag="duplicate" Click="OnCategoryFileClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Remaining category cards (wrap) ────────────────── -->
            <WrapPanel x:Name="CategoryPanel" Orientation="Horizontal" Margin="0,0,0,16"/>

            <!-- ── Bottom actions ──────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Открыть папку" Style="{StaticResource GhostBtn}"
                        Padding="20,8" Margin="0,0,8,0"
                        Click="OnOpenFolderClick"/>
                <Button Content="&#x2191;  Новый файл" Style="{StaticResource GhostBtn}"
                        Padding="20,8"
                        Click="OnNewFileClick"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
