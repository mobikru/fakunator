<UserControl x:Class="Fakunator.Views.CleanupIdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Fakunator.Controls"
             AllowDrop="True"
             DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <Grid>
        <!-- Layer 0: Particle background -->
        <controls:ParticleBackground/>

        <!-- Layer 1: Centered drop-zone content -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="600" Padding="20">
            <Border x:Name="DropBorder"
                    BorderThickness="2" CornerRadius="16" Padding="48,40"
                    Background="{DynamicResource DropZoneBgBrush}">
                <Border.BorderBrush>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Rectangle Width="600" Height="400"
                                       Stroke="{DynamicResource Border3Brush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="6 4"
                                       RadiusX="16" RadiusY="16"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.BorderBrush>

                <StackPanel HorizontalAlignment="Center">
                    <!-- @ icon in accent gradient circle -->
                    <Border Width="64" Height="64" CornerRadius="32"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5e6ad2" Offset="0"/>
                                <GradientStop Color="#818cf8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="@" Foreground="White" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Перетащите файл с email-адресами"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg1Brush}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Description -->
                    <TextBlock TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource Fg3Brush}"
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               TextWrapping="Wrap" MaxWidth="440"
                               LineHeight="20">
                        <Run Text="TXT, CSV или TSV — по одному адресу в строке."/>
                        <LineBreak/>
                        <Run Text="Дубликаты, ловушки, корпоративные домены и"/>
                        <LineBreak/>
                        <Run Text="одноразовые сервисы будут отсечены автоматически."/>
                    </TextBlock>

                    <!-- Button -->
                    <Button Content="Выбрать файл" Style="{StaticResource AccentBtn}"
                            HorizontalAlignment="Center" Padding="20,8"
                            Click="OnSelectFileClick"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
