<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <SolidColorBrush x:Key="Bg0Brush" Color="#ffffff"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#fafafa"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="#ffffff"/>
    <SolidColorBrush x:Key="Bg4Brush" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="Bg5Brush" Color="#e4e4e7"/>

    <!-- Foreground -->
    <SolidColorBrush x:Key="Fg1Brush" Color="#18181b"/>
    <SolidColorBrush x:Key="Fg2Brush" Color="#52525b"/>
    <SolidColorBrush x:Key="Fg3Brush" Color="#71717a"/>
    <SolidColorBrush x:Key="Fg4Brush" Color="#a1a1aa"/>

    <!-- Border -->
    <SolidColorBrush x:Key="Border1Brush" Color="#0F000000"/>
    <SolidColorBrush x:Key="Border2Brush" Color="#1A000000"/>
    <SolidColorBrush x:Key="Border3Brush" Color="#29000000"/>

    <!-- Accent (same in both themes) -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#5e6ad2"/>
    <SolidColorBrush x:Key="Accent2Brush"     Color="#818cf8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6b75d8"/>
    <SolidColorBrush x:Key="AccentSoftBrush"  Color="#245e6ad2"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="WindowBgBrush"    Color="#fafafa"/>
    <SolidColorBrush x:Key="CardBgBrush"      Color="#ffffff"/>
    <SolidColorBrush x:Key="SidebarBgBrush"   Color="#fafafa"/>
    <SolidColorBrush x:Key="HeaderBgBrush"    Color="#fafafa"/>
    <SolidColorBrush x:Key="DropZoneBgBrush"  Color="#C8ffffff"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181b"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#52525b"/>
    <SolidColorBrush x:Key="TextMutedBrush"   Color="#71717a"/>

    <!-- Clean/success -->
    <SolidColorBrush x:Key="CleanBrush"  Color="#22c55e"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>

</ResourceDictionary>
