<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <SolidColorBrush x:Key="Bg0Brush" Color="#0a0a0c"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#111114"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="#16161a"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="#1c1c21"/>
    <SolidColorBrush x:Key="Bg4Brush" Color="#232329"/>
    <SolidColorBrush x:Key="Bg5Brush" Color="#2c2c33"/>

    <!-- Foreground -->
    <SolidColorBrush x:Key="Fg1Brush" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="Fg2Brush" Color="#a1a1aa"/>
    <SolidColorBrush x:Key="Fg3Brush" Color="#71717a"/>
    <SolidColorBrush x:Key="Fg4Brush" Color="#52525b"/>

    <!-- Border -->
    <SolidColorBrush x:Key="Border1Brush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Border2Brush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Border3Brush" Color="#2EFFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#5e6ad2"/>
    <SolidColorBrush x:Key="Accent2Brush"     Color="#818cf8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6b75d8"/>
    <SolidColorBrush x:Key="AccentSoftBrush"  Color="#245e6ad2"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="WindowBgBrush"    Color="#111114"/>
    <SolidColorBrush x:Key="CardBgBrush"      Color="#16161a"/>
    <SolidColorBrush x:Key="SidebarBgBrush"   Color="#111114"/>
    <SolidColorBrush x:Key="HeaderBgBrush"    Color="#111114"/>
    <SolidColorBrush x:Key="DropZoneBgBrush"  Color="#371c1c21"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#a1a1aa"/>
    <SolidColorBrush x:Key="TextMutedBrush"   Color="#71717a"/>

    <!-- Clean/success -->
    <SolidColorBrush x:Key="CleanBrush"  Color="#22c55e"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>

</ResourceDictionary>
