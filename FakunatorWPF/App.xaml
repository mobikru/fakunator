<Application x:Class="Fakunator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fakunator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SharedStyles.xaml"/>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters -->
            <conv:IsoToFlagConverter x:Key="IsoToFlag"/>
            <conv:IsoToColorConverter x:Key="IsoToColor"/>
            <conv:IsoToFlagImageConverter x:Key="IsoToFlagImage"/>
            <conv:LameFlagConverter x:Key="LameFlag"/>
            <conv:NsHostsShortConverter x:Key="NsHostsShort"/>
            <conv:UnixToTimeConverter x:Key="UnixToTime"/>
            <conv:PercentWidthConverter x:Key="PercentWidth"/>
            <conv:StatusRuConverter x:Key="StatusRu"/>
            <conv:StatusColorConverter x:Key="StatusColor"/>
            <conv:ProviderOrDeadConverter x:Key="ProviderOrDead"/>
            <conv:HexToColorConverter x:Key="HexToColor"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:LessThanConverter x:Key="LessThan22" Threshold="22"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:PercentToWidthConverter x:Key="PercentToWidth"/>
            <conv:IntGtZeroToVisConverter x:Key="IntGtZeroToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
