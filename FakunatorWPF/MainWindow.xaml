<Window x:Class="Fakunator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Fakunator.Views"
        xmlns:controls="clr-namespace:Fakunator.Controls"
        xmlns:vm="clr-namespace:Fakunator.ViewModels"
        xmlns:conv="clr-namespace:Fakunator.Converters"
        Title="Факунатор" Width="1200" Height="900"
        MinWidth="1100" MinHeight="820"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico">

    <Window.Resources>
        <vm:StateToVisibilityConverter x:Key="StateToVis"/>
        <vm:SmtpStateToVisibilityConverter x:Key="SmtpStateToVis"/>
        <vm:AnalyzeStateToVisibilityConverter x:Key="AnalyzeStateToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Sub-tab bar (visible only for "База") -->
            <RowDefinition Height="*"/>    <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0,12,0">
                <!-- Logo -->
                <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="5"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5e6ad2" Offset="0"/>
                            <GradientStop Color="#818cf8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="e" Foreground="White" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="Факунатор" FontWeight="SemiBold"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtVersion" DockPanel.Dock="Left" Text="2.5.0" FontSize="11"
                           Foreground="{DynamicResource Fg4Brush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Update badge — виден только когда UpdateService нашёл новую версию -->
                <Border x:Name="UpdateBadge" DockPanel.Dock="Left"
                        Visibility="Collapsed" VerticalAlignment="Center"
                        Background="#fef2f2" BorderBrush="#fecaca" BorderThickness="1"
                        CornerRadius="10" Padding="8,3" Margin="0,0,10,0"
                        Cursor="Hand" MouseLeftButtonDown="OnUpdateBadgeClick"
                        ToolTip="Доступна новая версия — открыть баннер">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#ef4444" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtUpdateBadge" Text="доступно 2.6.0" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="#b91c1c" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Settings gear (right-docked) -->
                <Button x:Name="BtnSettings" DockPanel.Dock="Right" Content="⚙"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Настройки" Margin="4,0,0,0"
                        Click="OnSettingsClick"/>


                <!-- Spacer before context buttons -->
                <Border DockPanel.Dock="Right" Width="8"/>

                <!-- Context buttons (will be toggled by state later) -->
                <Button x:Name="BtnExport" DockPanel.Dock="Right" Content="↓  Экспорт всех"
                        Style="{StaticResource AccentBtn}" Visibility="Collapsed" Margin="4,0"/>
                <Button x:Name="BtnNew" DockPanel.Dock="Right" Content="↑  Новый файл"
                        Style="{StaticResource GhostBtn}" Visibility="Collapsed" Margin="4,0"/>

                <!-- Tab buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <!-- «База» объединяет Очистку / SMTP-проверку / Анализ — они появляются
                         как sub-tab bar в отдельной строке ниже. -->
                    <RadioButton x:Name="TabDatabase" Content="🗄  База" IsChecked="True"
                                 GroupName="Tabs" Style="{DynamicResource TabBtnStyle}"
                                 Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabDomains" Content="🌐  Сканер доменов"
                                 GroupName="Tabs" Style="{DynamicResource TabBtnStyle}"
                                 Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabDomainsMgr" Content="🌍  Домены"
                                 GroupName="Tabs" Style="{DynamicResource TabBtnStyle}"
                                 Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabAms" Content="📮  AMS"
                                 GroupName="Tabs" Style="{DynamicResource TabBtnStyle}"
                                 Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabPmta" Content="📡  PMTA"
                                 GroupName="Tabs" Style="{DynamicResource TabBtnStyle}"
                                 Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabServerInstall" Content="🖥  Сервера"
                                 GroupName="Tabs" Style="{DynamicResource TabBtnStyle}"
                                 Checked="OnTabChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Sub-tab bar (для «База»: Очистка / SMTP / Анализ) ──────────── -->
        <Border x:Name="DbSubTabBar" Grid.Row="1"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,4,16,4" VerticalAlignment="Center">
                <RadioButton x:Name="SubCleanup" Content="📧  Очистка" IsChecked="True"
                             GroupName="DbSubTabs" Style="{DynamicResource TabBtnStyle}"
                             Checked="OnDbSubTabChanged"/>
                <RadioButton x:Name="SubSmtp" Content="✉  SMTP-проверка"
                             GroupName="DbSubTabs" Style="{DynamicResource TabBtnStyle}"
                             Checked="OnDbSubTabChanged"/>
                <RadioButton x:Name="SubAnalyze" Content="🔬  Анализ"
                             GroupName="DbSubTabs" Style="{DynamicResource TabBtnStyle}"
                             Checked="OnDbSubTabChanged"/>
            </StackPanel>
        </Border>

        <!-- ── Body ────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300"/>  <!-- Sidebar -->
                <ColumnDefinition Width="*"/>    <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar (tab-specific; only one visible at a time) -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,1,0">
                <Grid>
                    <views:SidebarCleanupView x:Name="SidebarCleanup"/>
                    <views:SidebarSmtpView x:Name="SidebarSmtp" Visibility="Collapsed"/>
                    <views:SidebarAnalyzeView x:Name="SidebarAnalyze" Visibility="Collapsed"/>
                    <views:SidebarDomainScannerView x:Name="SidebarDomains" Visibility="Collapsed"/>
                    <views:SidebarDomainsManagerView x:Name="SidebarDomainsMgr" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Main content area — tab-switched panels -->
            <Grid Grid.Column="1">
                <!-- Cleanup panel (state-switched views) -->
                <Grid x:Name="CleanupPanel">
                    <Grid x:Name="ContentArea">
                        <views:CleanupIdleView x:Name="IdleView"
                            Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Idle}"/>
                        <views:CleanupLoadedView x:Name="LoadedView"
                            Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Loaded}"/>
                        <views:CleanupRunningView x:Name="RunningView"
                            Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Running}"/>
                        <views:CleanupDoneView x:Name="DoneView"
                            Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Done}"/>
                    </Grid>
                </Grid>

                <!-- SMTP panel (state-switched views) -->
                <Grid x:Name="SmtpPanel" Visibility="Collapsed">
                    <Grid x:Name="SmtpContentArea">
                        <views:SmtpIdleView x:Name="SmtpIdleView"
                            Visibility="{Binding State, Converter={StaticResource SmtpStateToVis}, ConverterParameter=Idle}"/>
                        <views:SmtpRunningView x:Name="SmtpRunningView"
                            Visibility="{Binding State, Converter={StaticResource SmtpStateToVis}, ConverterParameter=Running}"/>
                        <views:SmtpDoneView x:Name="SmtpDoneView"
                            Visibility="{Binding State, Converter={StaticResource SmtpStateToVis}, ConverterParameter=Done}"/>
                    </Grid>
                </Grid>

                <!-- Analyze panel (state-switched views) -->
                <Grid x:Name="AnalyzePanel" Visibility="Collapsed">
                    <Grid x:Name="AnalyzeContentArea">
                        <views:AnalyzeIdleView x:Name="AnalyzeIdleView"
                            Visibility="{Binding State, Converter={StaticResource AnalyzeStateToVis}, ConverterParameter=Idle}"/>
                        <views:AnalyzeRunningView x:Name="AnalyzeRunningView"
                            Visibility="{Binding State, Converter={StaticResource AnalyzeStateToVis}, ConverterParameter=Running}"/>
                        <views:AnalyzeDoneView x:Name="AnalyzeDoneView"
                            Visibility="{Binding State, Converter={StaticResource AnalyzeStateToVis}, ConverterParameter=Done}"/>
                    </Grid>
                </Grid>

                <!-- Domain Scanner panel -->
                <Grid x:Name="DomainsPanel" Visibility="Collapsed">
                    <views:DomainScannerView x:Name="DomainsView"/>
                </Grid>

                <!-- Domains Manager panel -->
                <Grid x:Name="DomainsMgrPanel" Visibility="Collapsed">
                    <views:DomainsManagerView x:Name="DomainsMgrView"/>
                </Grid>

                <!-- AMS panel -->
                <Grid x:Name="AmsPanel" Visibility="Collapsed">
                    <views:AmsView x:Name="AmsView"/>
                </Grid>

                <!-- PMTA panel -->
                <Grid x:Name="PmtaPanel" Visibility="Collapsed">
                    <views:PmtaView x:Name="PmtaViewCtrl"/>
                </Grid>

                <!-- Server Install panel -->
                <Grid x:Name="ServerInstallPanel" Visibility="Collapsed">
                    <views:ServerInstallView x:Name="ServerInstallViewCtrl"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── Update toast (overlay bottom-right, hidden by default) ── -->
        <Border x:Name="UpdateBanner" Grid.RowSpan="3"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" MaxWidth="360"
                Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                CornerRadius="12" Padding="18,14">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.22" ShadowDepth="0" BlurRadius="24"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg1Brush}">
                        <Run Text="🎉 "/><Run x:Name="TxtBannerTitle" Text="Fakunator 2.6.0"/>
                    </TextBlock>
                    <Button DockPanel.Dock="Right" Content="✕"
                            Width="24" Height="24" Padding="0" FontSize="11" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Foreground="{DynamicResource Fg4Brush}"
                            Focusable="False" Click="OnUpdateBannerClose">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
                <TextBlock x:Name="TxtBannerBody" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Fg3Brush}" LineHeight="17"
                           Text="Доступно новое обновление. Скачает 0.9 MB, установит и перезапустится."
                           Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBannerLater" Content="Позже"
                            Style="{DynamicResource GhostBtn}" Padding="12,6"
                            FontSize="11.5" Margin="0,0,8,0" Cursor="Hand"
                            Click="OnUpdateBannerClose"/>
                    <Button x:Name="BtnBannerUpdate" Content="Обновить"
                            Style="{DynamicResource AccentBtn}" Padding="18,6"
                            FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                            Click="OnUpdateBannerApply"/>
                </StackPanel>
                <!-- Прогресс-панель (только при работе) -->
                <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtUpdateStatus" Text="…" FontSize="10.5"
                               Foreground="{DynamicResource Fg4Brush}" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="100"
                                 Background="{DynamicResource Bg3Brush}" Foreground="#6366f1" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
